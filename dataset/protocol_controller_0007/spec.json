{
  "design_id": "protocol_controller_0007",
  "category": "protocol_controller",
  "template": "start_pause_resume",
  "description": "Protocol controller implementing start pause resume behavior.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true,
    "state": "IDLE"
  },
  "inputs": [
    "start",
    "pause",
    "resume",
    "done_in"
  ],
  "outputs": [
    "running",
    "paused",
    "done"
  ],
  "states": [
    "IDLE",
    "RUN",
    "PAUSE",
    "DONE"
  ],
  "state_outputs": {
    "IDLE": {
      "running": 0,
      "paused": 0,
      "done": 0
    },
    "RUN": {
      "running": 1,
      "paused": 0,
      "done": 0
    },
    "PAUSE": {
      "running": 0,
      "paused": 1,
      "done": 0
    },
    "DONE": {
      "running": 0,
      "paused": 0,
      "done": 1
    }
  },
  "transitions": [
    {
      "from": "IDLE",
      "when": "start",
      "to": "RUN"
    },
    {
      "from": "IDLE",
      "when": "!start",
      "to": "IDLE"
    },
    {
      "from": "RUN",
      "when": "done_in",
      "to": "DONE"
    },
    {
      "from": "RUN",
      "when": "!done_in && pause",
      "to": "PAUSE"
    },
    {
      "from": "RUN",
      "when": "!done_in && !pause",
      "to": "RUN"
    },
    {
      "from": "PAUSE",
      "when": "resume",
      "to": "RUN"
    },
    {
      "from": "PAUSE",
      "when": "!resume",
      "to": "PAUSE"
    },
    {
      "from": "DONE",
      "when": "true",
      "to": "IDLE"
    }
  ],
  "rtl_variants": [
    "canonical_case",
    "onehot_case",
    "nested_if",
    "factored_flags"
  ],
  "notes": [
    "All benchmark properties use interface-visible signals only.",
    "All RTL variants must be observationally equivalent after reset."
  ],
  "properties": [
    {
      "id": "P1_STATE_ENCODING",
      "sva_name": "p_state_encoding",
      "type": "invariant",
      "natural_language": "observable state outputs always encode at most one active mode",
      "expression": "$onehot0({running, paused, done})",
      "disable": "rst"
    },
    {
      "id": "P2_RESET",
      "sva_name": "p_reset_state",
      "type": "next_cycle_implication",
      "natural_language": "reset returns the controller to its reset behavior",
      "antecedent": "rst",
      "consequent": "!running && !paused && !done",
      "delay": 1
    },
    {
      "id": "P3_T1",
      "sva_name": "p_t1",
      "type": "next_cycle_implication",
      "natural_language": "IDLE transitions to RUN when start",
      "antecedent": "(!running && !paused && !done) && (start)",
      "consequent": "running && !paused && !done",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P4_T2",
      "sva_name": "p_t2",
      "type": "next_cycle_implication",
      "natural_language": "IDLE transitions to IDLE when !start",
      "antecedent": "(!running && !paused && !done) && (!start)",
      "consequent": "!running && !paused && !done",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_T3",
      "sva_name": "p_t3",
      "type": "next_cycle_implication",
      "natural_language": "RUN transitions to DONE when done_in",
      "antecedent": "(running && !paused && !done) && (done_in)",
      "consequent": "!running && !paused && done",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P6_T4",
      "sva_name": "p_t4",
      "type": "next_cycle_implication",
      "natural_language": "RUN transitions to PAUSE when !done_in && pause",
      "antecedent": "(running && !paused && !done) && (!done_in && pause)",
      "consequent": "!running && paused && !done",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P7_T5",
      "sva_name": "p_t5",
      "type": "next_cycle_implication",
      "natural_language": "RUN transitions to RUN when !done_in && !pause",
      "antecedent": "(running && !paused && !done) && (!done_in && !pause)",
      "consequent": "running && !paused && !done",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P8_T6",
      "sva_name": "p_t6",
      "type": "next_cycle_implication",
      "natural_language": "PAUSE transitions to RUN when resume",
      "antecedent": "(!running && paused && !done) && (resume)",
      "consequent": "running && !paused && !done",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P9_T7",
      "sva_name": "p_t7",
      "type": "next_cycle_implication",
      "natural_language": "PAUSE transitions to PAUSE when !resume",
      "antecedent": "(!running && paused && !done) && (!resume)",
      "consequent": "!running && paused && !done",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P10_T8",
      "sva_name": "p_t8",
      "type": "next_cycle_implication",
      "natural_language": "DONE transitions to IDLE when true",
      "antecedent": "!running && !paused && done",
      "consequent": "!running && !paused && !done",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "drop_t1",
      "kind": "replace_transition_guard",
      "from": "IDLE",
      "old": "start",
      "new": "false"
    },
    {
      "name": "drop_t2",
      "kind": "replace_transition_guard",
      "from": "IDLE",
      "old": "!start",
      "new": "false"
    },
    {
      "name": "drop_t3",
      "kind": "replace_transition_guard",
      "from": "RUN",
      "old": "done_in",
      "new": "false"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "programmatic_template_instantiation",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
