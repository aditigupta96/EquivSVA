// Generated from spec.json.
// Design: protocol_controller_0007

// P1_STATE_ENCODING: observable state outputs always encode at most one active mode.
p_state_encoding: assert property (@(posedge clk) disable iff (rst)
    $onehot0({running, paused, done}));

// P2_RESET: reset returns the controller to its reset behavior.
p_reset_state: assert property (@(posedge clk)
    (rst) |=> (!running && !paused && !done));

// P3_T1: IDLE transitions to RUN when start.
p_t1: assert property (@(posedge clk) disable iff (rst)
    ((!running && !paused && !done) && (start)) |=> (running && !paused && !done));

// P4_T2: IDLE transitions to IDLE when !start.
p_t2: assert property (@(posedge clk) disable iff (rst)
    ((!running && !paused && !done) && (!start)) |=> (!running && !paused && !done));

// P5_T3: RUN transitions to DONE when done_in.
p_t3: assert property (@(posedge clk) disable iff (rst)
    ((running && !paused && !done) && (done_in)) |=> (!running && !paused && done));

// P6_T4: RUN transitions to PAUSE when !done_in && pause.
p_t4: assert property (@(posedge clk) disable iff (rst)
    ((running && !paused && !done) && (!done_in && pause)) |=> (!running && paused && !done));

// P7_T5: RUN transitions to RUN when !done_in && !pause.
p_t5: assert property (@(posedge clk) disable iff (rst)
    ((running && !paused && !done) && (!done_in && !pause)) |=> (running && !paused && !done));

// P8_T6: PAUSE transitions to RUN when resume.
p_t6: assert property (@(posedge clk) disable iff (rst)
    ((!running && paused && !done) && (resume)) |=> (running && !paused && !done));

// P9_T7: PAUSE transitions to PAUSE when !resume.
p_t7: assert property (@(posedge clk) disable iff (rst)
    ((!running && paused && !done) && (!resume)) |=> (!running && paused && !done));

// P10_T8: DONE transitions to IDLE when true.
p_t8: assert property (@(posedge clk) disable iff (rst)
    (!running && !paused && done) |=> (!running && !paused && !done));
