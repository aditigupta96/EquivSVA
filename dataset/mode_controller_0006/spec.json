{
  "design_id": "mode_controller_0006",
  "category": "mode_controller",
  "template": "locked_unlocked",
  "description": "Mode controller implementing locked unlocked behavior.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true,
    "state": "LOCKED"
  },
  "inputs": [
    "unlock",
    "lock",
    "operate"
  ],
  "outputs": [
    "locked",
    "ready",
    "active"
  ],
  "states": [
    "LOCKED",
    "READY",
    "ACTIVE"
  ],
  "state_outputs": {
    "LOCKED": {
      "locked": 1,
      "ready": 0,
      "active": 0
    },
    "READY": {
      "locked": 0,
      "ready": 1,
      "active": 0
    },
    "ACTIVE": {
      "locked": 0,
      "ready": 0,
      "active": 1
    }
  },
  "transitions": [
    {
      "from": "LOCKED",
      "when": "unlock",
      "to": "READY"
    },
    {
      "from": "LOCKED",
      "when": "!unlock",
      "to": "LOCKED"
    },
    {
      "from": "READY",
      "when": "lock",
      "to": "LOCKED"
    },
    {
      "from": "READY",
      "when": "!lock && operate",
      "to": "ACTIVE"
    },
    {
      "from": "READY",
      "when": "!lock && !operate",
      "to": "READY"
    },
    {
      "from": "ACTIVE",
      "when": "lock",
      "to": "LOCKED"
    },
    {
      "from": "ACTIVE",
      "when": "!lock && !operate",
      "to": "READY"
    },
    {
      "from": "ACTIVE",
      "when": "!lock && operate",
      "to": "ACTIVE"
    }
  ],
  "rtl_variants": [
    "canonical_case",
    "onehot_case",
    "nested_if",
    "factored_flags"
  ],
  "notes": [
    "All benchmark properties use interface-visible signals only.",
    "All RTL variants must be observationally equivalent after reset."
  ],
  "properties": [
    {
      "id": "P1_STATE_ENCODING",
      "sva_name": "p_state_encoding",
      "type": "invariant",
      "natural_language": "observable state outputs always encode at most one active mode",
      "expression": "$onehot0({locked, ready, active})",
      "disable": "rst"
    },
    {
      "id": "P2_RESET",
      "sva_name": "p_reset_state",
      "type": "next_cycle_implication",
      "natural_language": "reset returns the controller to its reset behavior",
      "antecedent": "rst",
      "consequent": "locked && !ready && !active",
      "delay": 1
    },
    {
      "id": "P3_T1",
      "sva_name": "p_t1",
      "type": "next_cycle_implication",
      "natural_language": "LOCKED transitions to READY when unlock",
      "antecedent": "(locked && !ready && !active) && (unlock)",
      "consequent": "!locked && ready && !active",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P4_T2",
      "sva_name": "p_t2",
      "type": "next_cycle_implication",
      "natural_language": "LOCKED transitions to LOCKED when !unlock",
      "antecedent": "(locked && !ready && !active) && (!unlock)",
      "consequent": "locked && !ready && !active",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_T3",
      "sva_name": "p_t3",
      "type": "next_cycle_implication",
      "natural_language": "READY transitions to LOCKED when lock",
      "antecedent": "(!locked && ready && !active) && (lock)",
      "consequent": "locked && !ready && !active",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P6_T4",
      "sva_name": "p_t4",
      "type": "next_cycle_implication",
      "natural_language": "READY transitions to ACTIVE when !lock && operate",
      "antecedent": "(!locked && ready && !active) && (!lock && operate)",
      "consequent": "!locked && !ready && active",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P7_T5",
      "sva_name": "p_t5",
      "type": "next_cycle_implication",
      "natural_language": "READY transitions to READY when !lock && !operate",
      "antecedent": "(!locked && ready && !active) && (!lock && !operate)",
      "consequent": "!locked && ready && !active",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P8_T6",
      "sva_name": "p_t6",
      "type": "next_cycle_implication",
      "natural_language": "ACTIVE transitions to LOCKED when lock",
      "antecedent": "(!locked && !ready && active) && (lock)",
      "consequent": "locked && !ready && !active",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P9_T7",
      "sva_name": "p_t7",
      "type": "next_cycle_implication",
      "natural_language": "ACTIVE transitions to READY when !lock && !operate",
      "antecedent": "(!locked && !ready && active) && (!lock && !operate)",
      "consequent": "!locked && ready && !active",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P10_T8",
      "sva_name": "p_t8",
      "type": "next_cycle_implication",
      "natural_language": "ACTIVE transitions to ACTIVE when !lock && operate",
      "antecedent": "(!locked && !ready && active) && (!lock && operate)",
      "consequent": "!locked && !ready && active",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "drop_t1",
      "kind": "replace_transition_guard",
      "from": "LOCKED",
      "old": "unlock",
      "new": "false"
    },
    {
      "name": "drop_t2",
      "kind": "replace_transition_guard",
      "from": "LOCKED",
      "old": "!unlock",
      "new": "false"
    },
    {
      "name": "drop_t3",
      "kind": "replace_transition_guard",
      "from": "READY",
      "old": "lock",
      "new": "false"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "programmatic_template_instantiation",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
