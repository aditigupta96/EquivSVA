// Gold interface properties for timer_0008

// P1_RESET: reset restores the register to its reset value
property p_reset_value;
    @(posedge clk) (rst) |=> (age == 3'd0);
endproperty
assert property (p_reset_value);

// P2_TIMEOUT: timeout is consistent with the observable register value
property p_timeout;
    @(posedge clk) disable iff (rst) (timeout == (age == 3'd7));
endproperty
assert property (p_timeout);

// P3_RULE: update rule kick produces the specified next value
property p_rule_3;
    @(posedge clk) disable iff (rst) (kick) |=> (age == (3'd0));
endproperty
assert property (p_rule_3);

// P4_RULE: update rule !kick && tick && (age < 3'd7) produces the specified next value
property p_rule_4;
    @(posedge clk) disable iff (rst) (!kick && tick && (age < 3'd7)) |=> (age == ($past(age) + 3'd1));
endproperty
assert property (p_rule_4);

// P5_HOLD: when no update rule fires the register holds its value
property p_hold;
    @(posedge clk) disable iff (rst) (!(kick) && !(!kick && tick && (age < 3'd7))) |=> (age == $past(age));
endproperty
assert property (p_hold);
