{
  "design_id": "timer_0008",
  "category": "timer_watchdog",
  "model_type": "register_rules",
  "template": "reloadable_watchdog",
  "description": "Watchdog increments until kick resets it and saturates at timeout.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true
  },
  "inputs": [
    "kick",
    "tick"
  ],
  "outputs": [
    "age",
    "timeout"
  ],
  "signal_widths": {
    "age": 3
  },
  "registers": [
    {
      "name": "age",
      "width": 3,
      "reset_value": "3'd0",
      "observable": true
    }
  ],
  "derived_outputs": {
    "timeout": "age == 3'd7"
  },
  "update_rules": [
    {
      "when": "kick",
      "value": "3'd0"
    },
    {
      "when": "!kick && tick && (age < 3'd7)",
      "value": "age + 3'd1"
    },
    {
      "when": "true",
      "value": "age"
    }
  ],
  "rtl_variants": [
    {
      "name": "canonical",
      "module_suffix": "canonical_next",
      "file": "canonical_next.sv"
    },
    {
      "name": "sequential",
      "module_suffix": "sequential_priority",
      "file": "sequential_priority.sv"
    },
    {
      "name": "ternary",
      "module_suffix": "ternary_next",
      "file": "ternary_next.sv"
    },
    {
      "name": "function",
      "module_suffix": "function_update",
      "file": "function_update.sv"
    }
  ],
  "notes": [
    "The state register is interface-visible and part of observable equivalence.",
    "All benchmark properties use interface-visible signals only."
  ],
  "properties": [
    {
      "id": "P1_RESET",
      "sva_name": "p_reset_value",
      "type": "next_cycle_implication",
      "natural_language": "reset restores the register to its reset value",
      "antecedent": "rst",
      "consequent": "age == 3'd0",
      "delay": 1
    },
    {
      "id": "P2_TIMEOUT",
      "sva_name": "p_timeout",
      "type": "invariant",
      "natural_language": "timeout is consistent with the observable register value",
      "expression": "timeout == (age == 3'd7)",
      "disable": "rst"
    },
    {
      "id": "P3_RULE",
      "sva_name": "p_rule_3",
      "type": "next_cycle_implication",
      "natural_language": "update rule kick produces the specified next value",
      "antecedent": "kick",
      "consequent": "age == (3'd0)",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P4_RULE",
      "sva_name": "p_rule_4",
      "type": "next_cycle_implication",
      "natural_language": "update rule !kick && tick && (age < 3'd7) produces the specified next value",
      "antecedent": "!kick && tick && (age < 3'd7)",
      "consequent": "age == ($past(age) + 3'd1)",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_HOLD",
      "sva_name": "p_hold",
      "type": "next_cycle_implication",
      "natural_language": "when no update rule fires the register holds its value",
      "antecedent": "!(kick) && !(!kick && tick && (age < 3'd7))",
      "consequent": "age == $past(age)",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "ignore_kick",
      "kind": "replace_update_guard",
      "old": "kick",
      "new": "false"
    },
    {
      "name": "ignore_tick",
      "kind": "replace_update_guard",
      "old": "!kick && tick && (age < 3'd7)",
      "new": "false"
    },
    {
      "name": "age_without_tick",
      "kind": "replace_update_guard",
      "old": "!kick && tick && (age < 3'd7)",
      "new": "!kick && (age < 3'd7)"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "programmatic_template_instantiation",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
