{
  "design_id": "handshake_0005",
  "category": "handshake",
  "template": "request_grant_ack_release",
  "description": "A request enters a pending state until grant arrives. Grant raises acknowledgement, which remains asserted until the requester releases req.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "state": "IDLE"
  },
  "inputs": [
    "req",
    "grant"
  ],
  "outputs": [
    "pending",
    "ack"
  ],
  "states": [
    "IDLE",
    "WAIT",
    "ACK"
  ],
  "state_outputs": {
    "IDLE": {
      "pending": 0,
      "ack": 0
    },
    "WAIT": {
      "pending": 1,
      "ack": 0
    },
    "ACK": {
      "pending": 0,
      "ack": 1
    }
  },
  "transitions": [
    {
      "from": "IDLE",
      "when": "req",
      "to": "WAIT"
    },
    {
      "from": "IDLE",
      "when": "true",
      "to": "IDLE"
    },
    {
      "from": "WAIT",
      "when": "grant",
      "to": "ACK"
    },
    {
      "from": "WAIT",
      "when": "true",
      "to": "WAIT"
    },
    {
      "from": "ACK",
      "when": "!req",
      "to": "IDLE"
    },
    {
      "from": "ACK",
      "when": "true",
      "to": "ACK"
    }
  ],
  "properties": [
    {
      "id": "P1_MUTEX",
      "sva_name": "p_mutex",
      "type": "invariant",
      "natural_language": "pending and ack are never asserted together",
      "disable": "rst",
      "expression": "!(pending && ack)"
    },
    {
      "id": "P2_RESET_IDLE",
      "sva_name": "p_reset_idle",
      "type": "next_cycle_implication",
      "natural_language": "reset clears pending and acknowledgement",
      "antecedent": "rst",
      "consequent": "!pending && !ack",
      "delay": 1
    },
    {
      "id": "P3_REQUEST_TO_PENDING",
      "sva_name": "p_request_to_pending",
      "type": "next_cycle_implication",
      "natural_language": "a request while idle enters the pending state",
      "disable": "rst",
      "antecedent": "(!pending && !ack) && req",
      "consequent": "pending",
      "delay": 1
    },
    {
      "id": "P4_IDLE_HOLDS",
      "sva_name": "p_idle_holds",
      "type": "next_cycle_implication",
      "natural_language": "without a request the idle controller remains idle",
      "disable": "rst",
      "antecedent": "(!pending && !ack) && !req",
      "consequent": "!pending && !ack",
      "delay": 1
    },
    {
      "id": "P5_GRANT_TO_ACK",
      "sva_name": "p_grant_to_ack",
      "type": "next_cycle_implication",
      "natural_language": "granting a pending request raises acknowledgement",
      "disable": "rst",
      "antecedent": "pending && grant",
      "consequent": "ack",
      "delay": 1
    },
    {
      "id": "P6_PENDING_HOLDS",
      "sva_name": "p_pending_holds",
      "type": "next_cycle_implication",
      "natural_language": "a request remains pending until grant arrives",
      "disable": "rst",
      "antecedent": "pending && !grant",
      "consequent": "pending",
      "delay": 1
    },
    {
      "id": "P7_ACK_HOLDS",
      "sva_name": "p_ack_holds",
      "type": "next_cycle_implication",
      "natural_language": "acknowledgement remains asserted while req remains asserted",
      "disable": "rst",
      "antecedent": "ack && req",
      "consequent": "ack",
      "delay": 1
    },
    {
      "id": "P8_RELEASE_TO_IDLE",
      "sva_name": "p_release_to_idle",
      "type": "next_cycle_implication",
      "natural_language": "releasing req after acknowledgement returns the controller to idle",
      "disable": "rst",
      "antecedent": "ack && !req",
      "consequent": "!pending && !ack",
      "delay": 1
    }
  ],
  "mutants": [
    {
      "name": "ignore_request",
      "kind": "replace_transition_guard",
      "from": "IDLE",
      "old": "req",
      "new": "true"
    },
    {
      "name": "premature_ack",
      "kind": "force_transition",
      "from": "WAIT",
      "to": "ACK"
    },
    {
      "name": "ack_stuck",
      "kind": "force_transition",
      "from": "ACK",
      "to": "ACK"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "manually_authored",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
