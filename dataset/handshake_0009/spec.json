{
  "design_id": "handshake_0009",
  "category": "handshake",
  "template": "cancelable_valid_ready",
  "description": "Valid/ready transfer can be cancelled before acceptance.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true,
    "state": "IDLE"
  },
  "inputs": [
    "start",
    "ready",
    "cancel"
  ],
  "outputs": [
    "valid",
    "cancelled",
    "done"
  ],
  "states": [
    "IDLE",
    "VALID",
    "CANCEL",
    "DONE"
  ],
  "state_outputs": {
    "IDLE": {
      "valid": 0,
      "cancelled": 0,
      "done": 0
    },
    "VALID": {
      "valid": 1,
      "cancelled": 0,
      "done": 0
    },
    "CANCEL": {
      "valid": 0,
      "cancelled": 1,
      "done": 0
    },
    "DONE": {
      "valid": 0,
      "cancelled": 0,
      "done": 1
    }
  },
  "transitions": [
    {
      "from": "IDLE",
      "when": "start",
      "to": "VALID"
    },
    {
      "from": "IDLE",
      "when": "!start",
      "to": "IDLE"
    },
    {
      "from": "VALID",
      "when": "cancel",
      "to": "CANCEL"
    },
    {
      "from": "VALID",
      "when": "!cancel && ready",
      "to": "DONE"
    },
    {
      "from": "VALID",
      "when": "!cancel && !ready",
      "to": "VALID"
    },
    {
      "from": "CANCEL",
      "when": "true",
      "to": "IDLE"
    },
    {
      "from": "DONE",
      "when": "true",
      "to": "IDLE"
    }
  ],
  "rtl_variants": [
    "canonical_case",
    "onehot_case",
    "nested_if",
    "factored_flags"
  ],
  "notes": [
    "All benchmark properties use interface-visible signals only.",
    "All RTL variants must be observationally equivalent after reset."
  ],
  "properties": [
    {
      "id": "P1_STATE_ENCODING",
      "sva_name": "p_state_encoding",
      "type": "invariant",
      "natural_language": "observable state outputs always encode at most one active mode",
      "expression": "$onehot0({valid, cancelled, done})",
      "disable": "rst"
    },
    {
      "id": "P2_RESET",
      "sva_name": "p_reset_state",
      "type": "next_cycle_implication",
      "natural_language": "reset returns the controller to its reset behavior",
      "antecedent": "rst",
      "consequent": "!valid && !cancelled && !done",
      "delay": 1
    },
    {
      "id": "P3_T1",
      "sva_name": "p_t1",
      "type": "next_cycle_implication",
      "natural_language": "IDLE transitions to VALID when start",
      "antecedent": "(!valid && !cancelled && !done) && (start)",
      "consequent": "valid && !cancelled && !done",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P4_T2",
      "sva_name": "p_t2",
      "type": "next_cycle_implication",
      "natural_language": "IDLE transitions to IDLE when !start",
      "antecedent": "(!valid && !cancelled && !done) && (!start)",
      "consequent": "!valid && !cancelled && !done",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_T3",
      "sva_name": "p_t3",
      "type": "next_cycle_implication",
      "natural_language": "VALID transitions to CANCEL when cancel",
      "antecedent": "(valid && !cancelled && !done) && (cancel)",
      "consequent": "!valid && cancelled && !done",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P6_T4",
      "sva_name": "p_t4",
      "type": "next_cycle_implication",
      "natural_language": "VALID transitions to DONE when !cancel && ready",
      "antecedent": "(valid && !cancelled && !done) && (!cancel && ready)",
      "consequent": "!valid && !cancelled && done",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P7_T5",
      "sva_name": "p_t5",
      "type": "next_cycle_implication",
      "natural_language": "VALID transitions to VALID when !cancel && !ready",
      "antecedent": "(valid && !cancelled && !done) && (!cancel && !ready)",
      "consequent": "valid && !cancelled && !done",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P8_T6",
      "sva_name": "p_t6",
      "type": "next_cycle_implication",
      "natural_language": "CANCEL transitions to IDLE when true",
      "antecedent": "!valid && cancelled && !done",
      "consequent": "!valid && !cancelled && !done",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P9_T7",
      "sva_name": "p_t7",
      "type": "next_cycle_implication",
      "natural_language": "DONE transitions to IDLE when true",
      "antecedent": "!valid && !cancelled && done",
      "consequent": "!valid && !cancelled && !done",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "drop_t1",
      "kind": "replace_transition_guard",
      "from": "IDLE",
      "old": "start",
      "new": "false"
    },
    {
      "name": "drop_t2",
      "kind": "replace_transition_guard",
      "from": "IDLE",
      "old": "!start",
      "new": "false"
    },
    {
      "name": "drop_t3",
      "kind": "replace_transition_guard",
      "from": "VALID",
      "old": "cancel",
      "new": "false"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "programmatic_template_instantiation",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
