{
  "design_id": "saturating_arithmetic_0002",
  "category": "saturating_arithmetic",
  "model_type": "register_rules",
  "template": "loadable_bidirectional_saturator",
  "description": "Loadable four-bit accumulator with asymmetric saturating increment and decrement.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true
  },
  "inputs": [
    "load_mid",
    "inc",
    "dec"
  ],
  "outputs": [
    "value",
    "at_min",
    "at_max"
  ],
  "signal_widths": {
    "value": 4
  },
  "registers": [
    {
      "name": "value",
      "width": 4,
      "reset_value": "4'd8",
      "observable": true
    }
  ],
  "derived_outputs": {
    "at_min": "value == 4'd2",
    "at_max": "value == 4'd13"
  },
  "update_rules": [
    {
      "when": "load_mid",
      "value": "4'd8"
    },
    {
      "when": "!load_mid && inc && !dec && (value < 4'd13)",
      "value": "value + 4'd1"
    },
    {
      "when": "!load_mid && dec && !inc && (value > 4'd2)",
      "value": "value - 4'd1"
    },
    {
      "when": "true",
      "value": "value"
    }
  ],
  "rtl_variants": [
    {
      "name": "canonical",
      "module_suffix": "canonical_next",
      "file": "canonical_next.sv"
    },
    {
      "name": "sequential",
      "module_suffix": "sequential_priority",
      "file": "sequential_priority.sv"
    },
    {
      "name": "ternary",
      "module_suffix": "ternary_next",
      "file": "ternary_next.sv"
    },
    {
      "name": "function",
      "module_suffix": "function_update",
      "file": "function_update.sv"
    }
  ],
  "notes": [
    "The state register is interface-visible and part of observable equivalence.",
    "All benchmark properties use interface-visible signals only."
  ],
  "properties": [
    {
      "id": "P1_MIN",
      "sva_name": "p_min",
      "type": "invariant",
      "natural_language": "at_min reflects the lower saturation point",
      "expression": "at_min == (value == 4'd2)",
      "disable": "rst"
    },
    {
      "id": "P2_MAX",
      "sva_name": "p_max",
      "type": "invariant",
      "natural_language": "at_max reflects the upper saturation point",
      "expression": "at_max == (value == 4'd13)",
      "disable": "rst"
    },
    {
      "id": "P3_RESET",
      "sva_name": "p_reset",
      "type": "next_cycle_implication",
      "natural_language": "reset restores the midpoint",
      "antecedent": "rst",
      "consequent": "value == 4'd8",
      "delay": 1
    },
    {
      "id": "P4_LOAD",
      "sva_name": "p_load",
      "type": "next_cycle_implication",
      "natural_language": "load_mid restores the midpoint",
      "antecedent": "load_mid",
      "consequent": "value == 4'd8",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_INC",
      "sva_name": "p_inc",
      "type": "next_cycle_implication",
      "natural_language": "exclusive increment advances below the upper bound",
      "antecedent": "!load_mid && inc && !dec && (value < 4'd13)",
      "consequent": "value == ($past(value) + 4'd1)",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P6_DEC",
      "sva_name": "p_dec",
      "type": "next_cycle_implication",
      "natural_language": "exclusive decrement advances toward the lower bound",
      "antecedent": "!load_mid && dec && !inc && (value > 4'd2)",
      "consequent": "value == ($past(value) - 4'd1)",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P7_BOTH_HOLD",
      "sva_name": "p_both_hold",
      "type": "next_cycle_implication",
      "natural_language": "simultaneous increment and decrement cancel",
      "antecedent": "!load_mid && inc && dec",
      "consequent": "value == $past(value)",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "ignore_load",
      "kind": "replace_update_guard",
      "old": "load_mid",
      "new": "false"
    },
    {
      "name": "inc_when_both",
      "kind": "replace_update_guard",
      "old": "!load_mid && inc && !dec && (value < 4'd13)",
      "new": "!load_mid && inc && (value < 4'd13)"
    },
    {
      "name": "ignore_decrement",
      "kind": "replace_update_guard",
      "old": "!load_mid && dec && !inc && (value > 4'd2)",
      "new": "false"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "manually_authored",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
