{
  "design_id": "saturating_arithmetic_0007",
  "category": "saturating_arithmetic",
  "model_type": "register_rules",
  "template": "sat_floor_two",
  "description": "Saturating arithmetic unit implementing sat floor two.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true
  },
  "inputs": [
    "dec",
    "restore"
  ],
  "outputs": [
    "value",
    "at_floor"
  ],
  "signal_widths": {
    "value": 3
  },
  "registers": [
    {
      "name": "value",
      "width": 3,
      "reset_value": "3'd7",
      "observable": true
    }
  ],
  "derived_outputs": {
    "at_floor": "value == 3'd2"
  },
  "update_rules": [
    {
      "when": "restore",
      "value": "3'd7"
    },
    {
      "when": "!restore && dec && (value > 3'd2)",
      "value": "value - 3'd1"
    },
    {
      "when": "true",
      "value": "value"
    }
  ],
  "rtl_variants": [
    {
      "name": "canonical",
      "module_suffix": "canonical_next",
      "file": "canonical_next.sv"
    },
    {
      "name": "sequential",
      "module_suffix": "sequential_priority",
      "file": "sequential_priority.sv"
    },
    {
      "name": "ternary",
      "module_suffix": "ternary_next",
      "file": "ternary_next.sv"
    },
    {
      "name": "function",
      "module_suffix": "function_update",
      "file": "function_update.sv"
    }
  ],
  "notes": [
    "The state register is interface-visible and part of observable equivalence.",
    "All benchmark properties use interface-visible signals only."
  ],
  "properties": [
    {
      "id": "P1_RESET",
      "sva_name": "p_reset_value",
      "type": "next_cycle_implication",
      "natural_language": "reset restores the register to its reset value",
      "antecedent": "rst",
      "consequent": "value == 3'd7",
      "delay": 1
    },
    {
      "id": "P2_AT_FLOOR",
      "sva_name": "p_at_floor",
      "type": "invariant",
      "natural_language": "at_floor is consistent with the observable register value",
      "expression": "at_floor == (value == 3'd2)",
      "disable": "rst"
    },
    {
      "id": "P3_RULE",
      "sva_name": "p_rule_3",
      "type": "next_cycle_implication",
      "natural_language": "update rule restore produces the specified next value",
      "antecedent": "restore",
      "consequent": "value == (3'd7)",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P4_RULE",
      "sva_name": "p_rule_4",
      "type": "next_cycle_implication",
      "natural_language": "update rule !restore && dec && (value > 3'd2) produces the specified next value",
      "antecedent": "!restore && dec && (value > 3'd2)",
      "consequent": "value == ($past(value) - 3'd1)",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_HOLD",
      "sva_name": "p_hold",
      "type": "next_cycle_implication",
      "natural_language": "when no update rule fires the register holds its value",
      "antecedent": "!(restore) && !(!restore && dec && (value > 3'd2))",
      "consequent": "value == $past(value)",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "drop_rule_1",
      "kind": "replace_update_guard",
      "old": "restore",
      "new": "false"
    },
    {
      "name": "drop_rule_2",
      "kind": "replace_update_guard",
      "old": "!restore && dec && (value > 3'd2)",
      "new": "false"
    },
    {
      "name": "broaden_rule_3",
      "kind": "replace_update_guard",
      "old": "!restore && dec && (value > 3'd2)",
      "new": "true"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "programmatic_template_instantiation",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
