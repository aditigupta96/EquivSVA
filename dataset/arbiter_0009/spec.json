{
  "design_id": "arbiter_0009",
  "category": "arbiter",
  "template": "lockable_two_client",
  "description": "Two-client arbiter whose active grant can be locked.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true,
    "state": "IDLE"
  },
  "inputs": [
    "req0",
    "req1",
    "lock"
  ],
  "outputs": [
    "grant0",
    "grant1"
  ],
  "states": [
    "IDLE",
    "G0",
    "G1"
  ],
  "state_outputs": {
    "IDLE": {
      "grant0": 0,
      "grant1": 0
    },
    "G0": {
      "grant0": 1,
      "grant1": 0
    },
    "G1": {
      "grant0": 0,
      "grant1": 1
    }
  },
  "transitions": [
    {
      "from": "IDLE",
      "when": "req1",
      "to": "G1"
    },
    {
      "from": "IDLE",
      "when": "!req1 && req0",
      "to": "G0"
    },
    {
      "from": "IDLE",
      "when": "!req1 && !req0",
      "to": "IDLE"
    },
    {
      "from": "G0",
      "when": "lock",
      "to": "G0"
    },
    {
      "from": "G0",
      "when": "!lock",
      "to": "IDLE"
    },
    {
      "from": "G1",
      "when": "lock",
      "to": "G1"
    },
    {
      "from": "G1",
      "when": "!lock",
      "to": "IDLE"
    }
  ],
  "rtl_variants": [
    "canonical_case",
    "onehot_case",
    "nested_if",
    "factored_flags"
  ],
  "notes": [
    "All benchmark properties use interface-visible signals only.",
    "All RTL variants must be observationally equivalent after reset."
  ],
  "properties": [
    {
      "id": "P1_STATE_ENCODING",
      "sva_name": "p_state_encoding",
      "type": "invariant",
      "natural_language": "observable state outputs always encode at most one active mode",
      "expression": "$onehot0({grant0, grant1})",
      "disable": "rst"
    },
    {
      "id": "P2_RESET",
      "sva_name": "p_reset_state",
      "type": "next_cycle_implication",
      "natural_language": "reset returns the controller to its reset behavior",
      "antecedent": "rst",
      "consequent": "!grant0 && !grant1",
      "delay": 1
    },
    {
      "id": "P3_T1",
      "sva_name": "p_t1",
      "type": "next_cycle_implication",
      "natural_language": "IDLE transitions to G1 when req1",
      "antecedent": "(!grant0 && !grant1) && (req1)",
      "consequent": "!grant0 && grant1",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P4_T2",
      "sva_name": "p_t2",
      "type": "next_cycle_implication",
      "natural_language": "IDLE transitions to G0 when !req1 && req0",
      "antecedent": "(!grant0 && !grant1) && (!req1 && req0)",
      "consequent": "grant0 && !grant1",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_T3",
      "sva_name": "p_t3",
      "type": "next_cycle_implication",
      "natural_language": "IDLE transitions to IDLE when !req1 && !req0",
      "antecedent": "(!grant0 && !grant1) && (!req1 && !req0)",
      "consequent": "!grant0 && !grant1",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P6_T4",
      "sva_name": "p_t4",
      "type": "next_cycle_implication",
      "natural_language": "G0 transitions to G0 when lock",
      "antecedent": "(grant0 && !grant1) && (lock)",
      "consequent": "grant0 && !grant1",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P7_T5",
      "sva_name": "p_t5",
      "type": "next_cycle_implication",
      "natural_language": "G0 transitions to IDLE when !lock",
      "antecedent": "(grant0 && !grant1) && (!lock)",
      "consequent": "!grant0 && !grant1",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P8_T6",
      "sva_name": "p_t6",
      "type": "next_cycle_implication",
      "natural_language": "G1 transitions to G1 when lock",
      "antecedent": "(!grant0 && grant1) && (lock)",
      "consequent": "!grant0 && grant1",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P9_T7",
      "sva_name": "p_t7",
      "type": "next_cycle_implication",
      "natural_language": "G1 transitions to IDLE when !lock",
      "antecedent": "(!grant0 && grant1) && (!lock)",
      "consequent": "!grant0 && !grant1",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "drop_t1",
      "kind": "replace_transition_guard",
      "from": "IDLE",
      "old": "req1",
      "new": "false"
    },
    {
      "name": "drop_t2",
      "kind": "replace_transition_guard",
      "from": "IDLE",
      "old": "!req1 && req0",
      "new": "false"
    },
    {
      "name": "drop_t3",
      "kind": "replace_transition_guard",
      "from": "IDLE",
      "old": "!req1 && !req0",
      "new": "false"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "programmatic_template_instantiation",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
