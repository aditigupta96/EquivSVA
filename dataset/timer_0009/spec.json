{
  "design_id": "timer_0009",
  "category": "timer_watchdog",
  "model_type": "register_rules",
  "template": "pausable_timer",
  "description": "Pausable elapsed timer with clear and enable.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true
  },
  "inputs": [
    "clear",
    "enable"
  ],
  "outputs": [
    "count",
    "done"
  ],
  "signal_widths": {
    "count": 3
  },
  "registers": [
    {
      "name": "count",
      "width": 3,
      "reset_value": "3'd0",
      "observable": true
    }
  ],
  "derived_outputs": {
    "done": "count == 3'd5"
  },
  "update_rules": [
    {
      "when": "clear",
      "value": "3'd0"
    },
    {
      "when": "!clear && enable && (count < 3'd5)",
      "value": "count + 3'd1"
    },
    {
      "when": "true",
      "value": "count"
    }
  ],
  "rtl_variants": [
    {
      "name": "canonical",
      "module_suffix": "canonical_next",
      "file": "canonical_next.sv"
    },
    {
      "name": "sequential",
      "module_suffix": "sequential_priority",
      "file": "sequential_priority.sv"
    },
    {
      "name": "ternary",
      "module_suffix": "ternary_next",
      "file": "ternary_next.sv"
    },
    {
      "name": "function",
      "module_suffix": "function_update",
      "file": "function_update.sv"
    }
  ],
  "notes": [
    "The state register is interface-visible and part of observable equivalence.",
    "All benchmark properties use interface-visible signals only."
  ],
  "properties": [
    {
      "id": "P1_RESET",
      "sva_name": "p_reset_value",
      "type": "next_cycle_implication",
      "natural_language": "reset restores the register to its reset value",
      "antecedent": "rst",
      "consequent": "count == 3'd0",
      "delay": 1
    },
    {
      "id": "P2_DONE",
      "sva_name": "p_done",
      "type": "invariant",
      "natural_language": "done is consistent with the observable register value",
      "expression": "done == (count == 3'd5)",
      "disable": "rst"
    },
    {
      "id": "P3_RULE",
      "sva_name": "p_rule_3",
      "type": "next_cycle_implication",
      "natural_language": "update rule clear produces the specified next value",
      "antecedent": "clear",
      "consequent": "count == (3'd0)",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P4_RULE",
      "sva_name": "p_rule_4",
      "type": "next_cycle_implication",
      "natural_language": "update rule !clear && enable && (count < 3'd5) produces the specified next value",
      "antecedent": "!clear && enable && (count < 3'd5)",
      "consequent": "count == ($past(count) + 3'd1)",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_HOLD",
      "sva_name": "p_hold",
      "type": "next_cycle_implication",
      "natural_language": "when no update rule fires the register holds its value",
      "antecedent": "!(clear) && !(!clear && enable && (count < 3'd5))",
      "consequent": "count == $past(count)",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "ignore_clear",
      "kind": "replace_update_guard",
      "old": "clear",
      "new": "false"
    },
    {
      "name": "ignore_enable",
      "kind": "replace_update_guard",
      "old": "!clear && enable && (count < 3'd5)",
      "new": "!clear && (count < 3'd5)"
    },
    {
      "name": "never_advance",
      "kind": "replace_update_guard",
      "old": "!clear && enable && (count < 3'd5)",
      "new": "false"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "programmatic_template_instantiation",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
