[
  {
    "id": "P1_RESET",
    "sva_name": "p_reset_value",
    "type": "next_cycle_implication",
    "natural_language": "reset restores the register to its reset value",
    "antecedent": "rst",
    "consequent": "count == 3'd0",
    "delay": 1
  },
  {
    "id": "P2_DONE",
    "sva_name": "p_done",
    "type": "invariant",
    "natural_language": "done is consistent with the observable register value",
    "expression": "done == (count == 3'd5)",
    "disable": "rst"
  },
  {
    "id": "P3_RULE",
    "sva_name": "p_rule_3",
    "type": "next_cycle_implication",
    "natural_language": "update rule clear produces the specified next value",
    "antecedent": "clear",
    "consequent": "count == (3'd0)",
    "delay": 1,
    "disable": "rst"
  },
  {
    "id": "P4_RULE",
    "sva_name": "p_rule_4",
    "type": "next_cycle_implication",
    "natural_language": "update rule !clear && enable && (count < 3'd5) produces the specified next value",
    "antecedent": "!clear && enable && (count < 3'd5)",
    "consequent": "count == ($past(count) + 3'd1)",
    "delay": 1,
    "disable": "rst"
  },
  {
    "id": "P5_HOLD",
    "sva_name": "p_hold",
    "type": "next_cycle_implication",
    "natural_language": "when no update rule fires the register holds its value",
    "antecedent": "!(clear) && !(!clear && enable && (count < 3'd5))",
    "consequent": "count == $past(count)",
    "delay": 1,
    "disable": "rst"
  }
]
