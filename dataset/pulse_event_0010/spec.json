{
  "design_id": "pulse_event_0010",
  "category": "pulse_event",
  "template": "qualified_arm_fire_rearm",
  "description": "Pulse requires explicit arm, a trigger, then explicit rearm after firing.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true,
    "state": "DISARMED"
  },
  "inputs": [
    "arm",
    "trigger",
    "rearm"
  ],
  "outputs": [
    "disarmed",
    "armed",
    "pulse",
    "spent"
  ],
  "states": [
    "DISARMED",
    "ARMED",
    "PULSE",
    "SPENT"
  ],
  "state_outputs": {
    "DISARMED": {
      "disarmed": 1,
      "armed": 0,
      "pulse": 0,
      "spent": 0
    },
    "ARMED": {
      "disarmed": 0,
      "armed": 1,
      "pulse": 0,
      "spent": 0
    },
    "PULSE": {
      "disarmed": 0,
      "armed": 0,
      "pulse": 1,
      "spent": 0
    },
    "SPENT": {
      "disarmed": 0,
      "armed": 0,
      "pulse": 0,
      "spent": 1
    }
  },
  "transitions": [
    {
      "from": "DISARMED",
      "when": "arm",
      "to": "ARMED"
    },
    {
      "from": "DISARMED",
      "when": "!arm",
      "to": "DISARMED"
    },
    {
      "from": "ARMED",
      "when": "trigger",
      "to": "PULSE"
    },
    {
      "from": "ARMED",
      "when": "!trigger",
      "to": "ARMED"
    },
    {
      "from": "PULSE",
      "when": "true",
      "to": "SPENT"
    },
    {
      "from": "SPENT",
      "when": "rearm",
      "to": "ARMED"
    },
    {
      "from": "SPENT",
      "when": "!rearm",
      "to": "SPENT"
    }
  ],
  "rtl_variants": [
    "canonical_case",
    "onehot_case",
    "nested_if",
    "factored_flags"
  ],
  "notes": [
    "All benchmark properties use interface-visible signals only.",
    "All RTL variants must be observationally equivalent after reset."
  ],
  "properties": [
    {
      "id": "P1_ONEHOT",
      "sva_name": "p_onehot",
      "type": "invariant",
      "natural_language": "event detector modes are mutually exclusive",
      "expression": "$onehot({disarmed, armed, pulse, spent})",
      "disable": "rst"
    },
    {
      "id": "P2_RESET",
      "sva_name": "p_reset",
      "type": "next_cycle_implication",
      "natural_language": "reset disarms the detector",
      "antecedent": "rst",
      "consequent": "disarmed",
      "delay": 1
    },
    {
      "id": "P3_ARM",
      "sva_name": "p_arm",
      "type": "next_cycle_implication",
      "natural_language": "arm enables triggering",
      "antecedent": "disarmed && arm",
      "consequent": "armed",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P4_FIRE",
      "sva_name": "p_fire",
      "type": "next_cycle_implication",
      "natural_language": "trigger while armed emits a pulse",
      "antecedent": "armed && trigger",
      "consequent": "pulse",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_SPENT",
      "sva_name": "p_spent",
      "type": "next_cycle_implication",
      "natural_language": "a pulse becomes spent after one cycle",
      "antecedent": "pulse",
      "consequent": "spent",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P6_REARM",
      "sva_name": "p_rearm",
      "type": "next_cycle_implication",
      "natural_language": "explicit rearm makes a spent detector armed again",
      "antecedent": "spent && rearm",
      "consequent": "armed",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "arm_ignored",
      "kind": "replace_transition_guard",
      "from": "DISARMED",
      "old": "arm",
      "new": "false"
    },
    {
      "name": "trigger_ignored",
      "kind": "replace_transition_guard",
      "from": "ARMED",
      "old": "trigger",
      "new": "false"
    },
    {
      "name": "premature_rearm",
      "kind": "force_transition",
      "from": "PULSE",
      "to": "ARMED"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "manually_authored",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
