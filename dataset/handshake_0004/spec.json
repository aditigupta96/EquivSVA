{
  "design_id": "handshake_0004",
  "category": "handshake",
  "template": "valid_ready_buffer",
  "description": "A one-entry valid/ready buffer. A push makes data valid, valid remains asserted while the receiver is not ready, and a ready cycle consumes the entry.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "state": "EMPTY"
  },
  "inputs": [
    "push",
    "ready"
  ],
  "outputs": [
    "valid"
  ],
  "states": [
    "EMPTY",
    "FULL"
  ],
  "state_outputs": {
    "EMPTY": {
      "valid": 0
    },
    "FULL": {
      "valid": 1
    }
  },
  "transitions": [
    {
      "from": "EMPTY",
      "when": "push",
      "to": "FULL"
    },
    {
      "from": "EMPTY",
      "when": "true",
      "to": "EMPTY"
    },
    {
      "from": "FULL",
      "when": "ready",
      "to": "EMPTY"
    },
    {
      "from": "FULL",
      "when": "true",
      "to": "FULL"
    }
  ],
  "properties": [
    {
      "id": "P1_RESET_EMPTY",
      "sva_name": "p_reset_empty",
      "type": "next_cycle_implication",
      "natural_language": "reset clears valid",
      "antecedent": "rst",
      "consequent": "!valid",
      "delay": 1
    },
    {
      "id": "P2_PUSH_TO_VALID",
      "sva_name": "p_push_to_valid",
      "type": "next_cycle_implication",
      "natural_language": "a push into an empty buffer makes the output valid",
      "disable": "rst",
      "antecedent": "!valid && push",
      "consequent": "valid",
      "delay": 1
    },
    {
      "id": "P3_EMPTY_HOLDS",
      "sva_name": "p_empty_holds",
      "type": "next_cycle_implication",
      "natural_language": "an empty buffer remains empty without a push",
      "disable": "rst",
      "antecedent": "!valid && !push",
      "consequent": "!valid",
      "delay": 1
    },
    {
      "id": "P4_READY_CONSUMES",
      "sva_name": "p_ready_consumes",
      "type": "next_cycle_implication",
      "natural_language": "a ready receiver consumes a valid entry",
      "disable": "rst",
      "antecedent": "valid && ready",
      "consequent": "!valid",
      "delay": 1
    },
    {
      "id": "P5_BACKPRESSURE_HOLDS",
      "sva_name": "p_backpressure_holds",
      "type": "next_cycle_implication",
      "natural_language": "valid remains asserted while the receiver is not ready",
      "disable": "rst",
      "antecedent": "valid && !ready",
      "consequent": "valid",
      "delay": 1
    }
  ],
  "mutants": [
    {
      "name": "spurious_valid",
      "kind": "replace_transition_guard",
      "from": "EMPTY",
      "old": "push",
      "new": "true"
    },
    {
      "name": "drop_without_ready",
      "kind": "force_transition",
      "from": "FULL",
      "to": "EMPTY"
    },
    {
      "name": "stuck_valid",
      "kind": "force_transition",
      "from": "FULL",
      "to": "FULL"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "manually_authored",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
