{
  "design_id": "pulse_event_0007",
  "category": "pulse_event",
  "template": "two_cycle_cooldown",
  "description": "Pulse/event controller implementing two cycle cooldown semantics.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true,
    "state": "ARMED"
  },
  "inputs": [
    "trigger"
  ],
  "outputs": [
    "armed",
    "pulse",
    "cooldown1",
    "cooldown2"
  ],
  "states": [
    "ARMED",
    "PULSE",
    "COOL1",
    "COOL2"
  ],
  "state_outputs": {
    "ARMED": {
      "armed": 1,
      "pulse": 0,
      "cooldown1": 0,
      "cooldown2": 0
    },
    "PULSE": {
      "armed": 0,
      "pulse": 1,
      "cooldown1": 0,
      "cooldown2": 0
    },
    "COOL1": {
      "armed": 0,
      "pulse": 0,
      "cooldown1": 1,
      "cooldown2": 0
    },
    "COOL2": {
      "armed": 0,
      "pulse": 0,
      "cooldown1": 0,
      "cooldown2": 1
    }
  },
  "transitions": [
    {
      "from": "ARMED",
      "when": "trigger",
      "to": "PULSE"
    },
    {
      "from": "ARMED",
      "when": "!trigger",
      "to": "ARMED"
    },
    {
      "from": "PULSE",
      "when": "true",
      "to": "COOL1"
    },
    {
      "from": "COOL1",
      "when": "true",
      "to": "COOL2"
    },
    {
      "from": "COOL2",
      "when": "true",
      "to": "ARMED"
    }
  ],
  "rtl_variants": [
    "canonical_case",
    "onehot_case",
    "nested_if",
    "factored_flags"
  ],
  "notes": [
    "All benchmark properties use interface-visible signals only.",
    "All RTL variants must be observationally equivalent after reset."
  ],
  "properties": [
    {
      "id": "P1_ONEHOT",
      "sva_name": "p_onehot",
      "type": "invariant",
      "natural_language": "exactly one pulse-controller phase is externally visible",
      "expression": "$onehot({armed, pulse, cooldown1, cooldown2})",
      "disable": "rst"
    },
    {
      "id": "P2_RESET",
      "sva_name": "p_reset",
      "type": "next_cycle_implication",
      "natural_language": "reset arms the pulse controller",
      "antecedent": "rst",
      "consequent": "armed",
      "delay": 1
    },
    {
      "id": "P3_FIRE",
      "sva_name": "p_fire",
      "type": "next_cycle_implication",
      "natural_language": "a trigger while armed emits a one-cycle pulse",
      "antecedent": "armed && trigger",
      "consequent": "pulse",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P4_IDLE",
      "sva_name": "p_idle",
      "type": "next_cycle_implication",
      "natural_language": "without a trigger the armed controller remains armed",
      "antecedent": "armed && !trigger",
      "consequent": "armed",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_COOL1",
      "sva_name": "p_cool1",
      "type": "next_cycle_implication",
      "natural_language": "a pulse enters the first cooldown phase",
      "antecedent": "pulse",
      "consequent": "cooldown1",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P6_COOL2",
      "sva_name": "p_cool2",
      "type": "next_cycle_implication",
      "natural_language": "the first cooldown phase advances to the second",
      "antecedent": "cooldown1",
      "consequent": "cooldown2",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P7_REARM",
      "sva_name": "p_rearm",
      "type": "next_cycle_implication",
      "natural_language": "the second cooldown phase rearms the controller",
      "antecedent": "cooldown2",
      "consequent": "armed",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "drop_t1",
      "kind": "replace_transition_guard",
      "from": "ARMED",
      "old": "trigger",
      "new": "false"
    },
    {
      "name": "force_exit_t2",
      "kind": "force_transition",
      "from": "ARMED",
      "to": "PULSE"
    },
    {
      "name": "redirect_t3",
      "kind": "force_transition",
      "from": "PULSE",
      "to": "ARMED"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "programmatic_template_instantiation",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
