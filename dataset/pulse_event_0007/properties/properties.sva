// Generated from spec.json.
// Design: pulse_event_0007

// P1_ONEHOT: exactly one pulse-controller phase is externally visible.
p_onehot: assert property (@(posedge clk) disable iff (rst)
    $onehot({armed, pulse, cooldown1, cooldown2}));

// P2_RESET: reset arms the pulse controller.
p_reset: assert property (@(posedge clk)
    (rst) |=> (armed));

// P3_FIRE: a trigger while armed emits a one-cycle pulse.
p_fire: assert property (@(posedge clk) disable iff (rst)
    (armed && trigger) |=> (pulse));

// P4_IDLE: without a trigger the armed controller remains armed.
p_idle: assert property (@(posedge clk) disable iff (rst)
    (armed && !trigger) |=> (armed));

// P5_COOL1: a pulse enters the first cooldown phase.
p_cool1: assert property (@(posedge clk) disable iff (rst)
    (pulse) |=> (cooldown1));

// P6_COOL2: the first cooldown phase advances to the second.
p_cool2: assert property (@(posedge clk) disable iff (rst)
    (cooldown1) |=> (cooldown2));

// P7_REARM: the second cooldown phase rearms the controller.
p_rearm: assert property (@(posedge clk) disable iff (rst)
    (cooldown2) |=> (armed));
