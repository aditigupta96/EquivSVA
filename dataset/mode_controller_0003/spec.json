{
  "design_id": "mode_controller_0003",
  "category": "mode_controller",
  "template": "normal_maintenance",
  "description": "Mode controller implementing normal maintenance behavior.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true,
    "state": "OFF"
  },
  "inputs": [
    "enable",
    "maintenance",
    "exit_maintenance"
  ],
  "outputs": [
    "normal",
    "maint",
    "off"
  ],
  "states": [
    "OFF",
    "NORMAL",
    "MAINT"
  ],
  "state_outputs": {
    "OFF": {
      "normal": 0,
      "maint": 0,
      "off": 1
    },
    "NORMAL": {
      "normal": 1,
      "maint": 0,
      "off": 0
    },
    "MAINT": {
      "normal": 0,
      "maint": 1,
      "off": 0
    }
  },
  "transitions": [
    {
      "from": "OFF",
      "when": "enable",
      "to": "NORMAL"
    },
    {
      "from": "OFF",
      "when": "!enable",
      "to": "OFF"
    },
    {
      "from": "NORMAL",
      "when": "maintenance",
      "to": "MAINT"
    },
    {
      "from": "NORMAL",
      "when": "!maintenance && !enable",
      "to": "OFF"
    },
    {
      "from": "NORMAL",
      "when": "!maintenance && enable",
      "to": "NORMAL"
    },
    {
      "from": "MAINT",
      "when": "exit_maintenance",
      "to": "NORMAL"
    },
    {
      "from": "MAINT",
      "when": "!exit_maintenance",
      "to": "MAINT"
    }
  ],
  "rtl_variants": [
    "canonical_case",
    "onehot_case",
    "nested_if",
    "factored_flags"
  ],
  "notes": [
    "All benchmark properties use interface-visible signals only.",
    "All RTL variants must be observationally equivalent after reset."
  ],
  "properties": [
    {
      "id": "P1_STATE_ENCODING",
      "sva_name": "p_state_encoding",
      "type": "invariant",
      "natural_language": "observable state outputs always encode at most one active mode",
      "expression": "$onehot0({normal, maint, off})",
      "disable": "rst"
    },
    {
      "id": "P2_RESET",
      "sva_name": "p_reset_state",
      "type": "next_cycle_implication",
      "natural_language": "reset returns the controller to its reset behavior",
      "antecedent": "rst",
      "consequent": "!normal && !maint && off",
      "delay": 1
    },
    {
      "id": "P3_T1",
      "sva_name": "p_t1",
      "type": "next_cycle_implication",
      "natural_language": "OFF transitions to NORMAL when enable",
      "antecedent": "(!normal && !maint && off) && (enable)",
      "consequent": "normal && !maint && !off",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P4_T2",
      "sva_name": "p_t2",
      "type": "next_cycle_implication",
      "natural_language": "OFF transitions to OFF when !enable",
      "antecedent": "(!normal && !maint && off) && (!enable)",
      "consequent": "!normal && !maint && off",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_T3",
      "sva_name": "p_t3",
      "type": "next_cycle_implication",
      "natural_language": "NORMAL transitions to MAINT when maintenance",
      "antecedent": "(normal && !maint && !off) && (maintenance)",
      "consequent": "!normal && maint && !off",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P6_T4",
      "sva_name": "p_t4",
      "type": "next_cycle_implication",
      "natural_language": "NORMAL transitions to OFF when !maintenance && !enable",
      "antecedent": "(normal && !maint && !off) && (!maintenance && !enable)",
      "consequent": "!normal && !maint && off",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P7_T5",
      "sva_name": "p_t5",
      "type": "next_cycle_implication",
      "natural_language": "NORMAL transitions to NORMAL when !maintenance && enable",
      "antecedent": "(normal && !maint && !off) && (!maintenance && enable)",
      "consequent": "normal && !maint && !off",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P8_T6",
      "sva_name": "p_t6",
      "type": "next_cycle_implication",
      "natural_language": "MAINT transitions to NORMAL when exit_maintenance",
      "antecedent": "(!normal && maint && !off) && (exit_maintenance)",
      "consequent": "normal && !maint && !off",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P9_T7",
      "sva_name": "p_t7",
      "type": "next_cycle_implication",
      "natural_language": "MAINT transitions to MAINT when !exit_maintenance",
      "antecedent": "(!normal && maint && !off) && (!exit_maintenance)",
      "consequent": "!normal && maint && !off",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "drop_t1",
      "kind": "replace_transition_guard",
      "from": "OFF",
      "old": "enable",
      "new": "false"
    },
    {
      "name": "force_exit_t2",
      "kind": "force_transition",
      "from": "OFF",
      "to": "NORMAL"
    },
    {
      "name": "drop_t3",
      "kind": "replace_transition_guard",
      "from": "NORMAL",
      "old": "maintenance",
      "new": "false"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "programmatic_template_instantiation",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
