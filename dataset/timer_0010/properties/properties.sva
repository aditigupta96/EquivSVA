// Gold interface properties for timer_0010

// P1_RESET: reset restores the register to its reset value
property p_reset_value;
    @(posedge clk) (rst) |=> (phase == 3'd0);
endproperty
assert property (p_reset_value);

// P2_TERMINAL: terminal is consistent with the observable register value
property p_terminal;
    @(posedge clk) disable iff (rst) (terminal == (phase == 3'd7));
endproperty
assert property (p_terminal);

// P3_RULE: update rule restart produces the specified next value
property p_rule_3;
    @(posedge clk) disable iff (rst) (restart) |=> (phase == (3'd0));
endproperty
assert property (p_rule_3);

// P4_RULE: update rule !restart && tick && (phase < 3'd7) produces the specified next value
property p_rule_4;
    @(posedge clk) disable iff (rst) (!restart && tick && (phase < 3'd7)) |=> (phase == ($past(phase) + 3'd1));
endproperty
assert property (p_rule_4);

// P5_RULE: update rule !restart && tick && (phase == 3'd7) produces the specified next value
property p_rule_5;
    @(posedge clk) disable iff (rst) (!restart && tick && (phase == 3'd7)) |=> (phase == (3'd0));
endproperty
assert property (p_rule_5);

// P6_HOLD: when no update rule fires the register holds its value
property p_hold;
    @(posedge clk) disable iff (rst) (!(restart) && !(!restart && tick && (phase < 3'd7)) && !(!restart && tick && (phase == 3'd7))) |=> (phase == $past(phase));
endproperty
assert property (p_hold);
