{
  "design_id": "mode_controller_0005",
  "category": "mode_controller",
  "template": "idle_active_boost",
  "description": "Mode controller implementing idle active boost behavior.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true,
    "state": "IDLE"
  },
  "inputs": [
    "activate",
    "boost",
    "idle"
  ],
  "outputs": [
    "active",
    "boosted",
    "idle_mode"
  ],
  "states": [
    "IDLE",
    "ACTIVE",
    "BOOST"
  ],
  "state_outputs": {
    "IDLE": {
      "active": 0,
      "boosted": 0,
      "idle_mode": 1
    },
    "ACTIVE": {
      "active": 1,
      "boosted": 0,
      "idle_mode": 0
    },
    "BOOST": {
      "active": 0,
      "boosted": 1,
      "idle_mode": 0
    }
  },
  "transitions": [
    {
      "from": "IDLE",
      "when": "activate",
      "to": "ACTIVE"
    },
    {
      "from": "IDLE",
      "when": "!activate",
      "to": "IDLE"
    },
    {
      "from": "ACTIVE",
      "when": "boost",
      "to": "BOOST"
    },
    {
      "from": "ACTIVE",
      "when": "!boost && idle",
      "to": "IDLE"
    },
    {
      "from": "ACTIVE",
      "when": "!boost && !idle",
      "to": "ACTIVE"
    },
    {
      "from": "BOOST",
      "when": "boost",
      "to": "BOOST"
    },
    {
      "from": "BOOST",
      "when": "!boost",
      "to": "ACTIVE"
    }
  ],
  "rtl_variants": [
    "canonical_case",
    "onehot_case",
    "nested_if",
    "factored_flags"
  ],
  "notes": [
    "All benchmark properties use interface-visible signals only.",
    "All RTL variants must be observationally equivalent after reset."
  ],
  "properties": [
    {
      "id": "P1_STATE_ENCODING",
      "sva_name": "p_state_encoding",
      "type": "invariant",
      "natural_language": "observable state outputs always encode at most one active mode",
      "expression": "$onehot0({active, boosted, idle_mode})",
      "disable": "rst"
    },
    {
      "id": "P2_RESET",
      "sva_name": "p_reset_state",
      "type": "next_cycle_implication",
      "natural_language": "reset returns the controller to its reset behavior",
      "antecedent": "rst",
      "consequent": "!active && !boosted && idle_mode",
      "delay": 1
    },
    {
      "id": "P3_T1",
      "sva_name": "p_t1",
      "type": "next_cycle_implication",
      "natural_language": "IDLE transitions to ACTIVE when activate",
      "antecedent": "(!active && !boosted && idle_mode) && (activate)",
      "consequent": "active && !boosted && !idle_mode",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P4_T2",
      "sva_name": "p_t2",
      "type": "next_cycle_implication",
      "natural_language": "IDLE transitions to IDLE when !activate",
      "antecedent": "(!active && !boosted && idle_mode) && (!activate)",
      "consequent": "!active && !boosted && idle_mode",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_T3",
      "sva_name": "p_t3",
      "type": "next_cycle_implication",
      "natural_language": "ACTIVE transitions to BOOST when boost",
      "antecedent": "(active && !boosted && !idle_mode) && (boost)",
      "consequent": "!active && boosted && !idle_mode",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P6_T4",
      "sva_name": "p_t4",
      "type": "next_cycle_implication",
      "natural_language": "ACTIVE transitions to IDLE when !boost && idle",
      "antecedent": "(active && !boosted && !idle_mode) && (!boost && idle)",
      "consequent": "!active && !boosted && idle_mode",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P7_T5",
      "sva_name": "p_t5",
      "type": "next_cycle_implication",
      "natural_language": "ACTIVE transitions to ACTIVE when !boost && !idle",
      "antecedent": "(active && !boosted && !idle_mode) && (!boost && !idle)",
      "consequent": "active && !boosted && !idle_mode",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P8_T6",
      "sva_name": "p_t6",
      "type": "next_cycle_implication",
      "natural_language": "BOOST transitions to BOOST when boost",
      "antecedent": "(!active && boosted && !idle_mode) && (boost)",
      "consequent": "!active && boosted && !idle_mode",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P9_T7",
      "sva_name": "p_t7",
      "type": "next_cycle_implication",
      "natural_language": "BOOST transitions to ACTIVE when !boost",
      "antecedent": "(!active && boosted && !idle_mode) && (!boost)",
      "consequent": "active && !boosted && !idle_mode",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "drop_t1",
      "kind": "replace_transition_guard",
      "from": "IDLE",
      "old": "activate",
      "new": "false"
    },
    {
      "name": "drop_t2",
      "kind": "replace_transition_guard",
      "from": "IDLE",
      "old": "!activate",
      "new": "false"
    },
    {
      "name": "drop_t3",
      "kind": "replace_transition_guard",
      "from": "ACTIVE",
      "old": "boost",
      "new": "false"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "programmatic_template_instantiation",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
