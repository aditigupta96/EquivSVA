{
  "design_id": "mode_controller_0007",
  "category": "mode_controller",
  "template": "standby_run_fault",
  "description": "Mode controller implementing standby run fault behavior.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true,
    "state": "STANDBY"
  },
  "inputs": [
    "run",
    "fault",
    "clear"
  ],
  "outputs": [
    "standby",
    "running",
    "faulted"
  ],
  "states": [
    "STANDBY",
    "RUN",
    "FAULT"
  ],
  "state_outputs": {
    "STANDBY": {
      "standby": 1,
      "running": 0,
      "faulted": 0
    },
    "RUN": {
      "standby": 0,
      "running": 1,
      "faulted": 0
    },
    "FAULT": {
      "standby": 0,
      "running": 0,
      "faulted": 1
    }
  },
  "transitions": [
    {
      "from": "STANDBY",
      "when": "run",
      "to": "RUN"
    },
    {
      "from": "STANDBY",
      "when": "!run",
      "to": "STANDBY"
    },
    {
      "from": "RUN",
      "when": "fault",
      "to": "FAULT"
    },
    {
      "from": "RUN",
      "when": "!fault && run",
      "to": "RUN"
    },
    {
      "from": "RUN",
      "when": "!fault && !run",
      "to": "STANDBY"
    },
    {
      "from": "FAULT",
      "when": "clear",
      "to": "STANDBY"
    },
    {
      "from": "FAULT",
      "when": "!clear",
      "to": "FAULT"
    }
  ],
  "rtl_variants": [
    "canonical_case",
    "onehot_case",
    "nested_if",
    "factored_flags"
  ],
  "notes": [
    "All benchmark properties use interface-visible signals only.",
    "All RTL variants must be observationally equivalent after reset."
  ],
  "properties": [
    {
      "id": "P1_STATE_ENCODING",
      "sva_name": "p_state_encoding",
      "type": "invariant",
      "natural_language": "observable state outputs always encode at most one active mode",
      "expression": "$onehot0({standby, running, faulted})",
      "disable": "rst"
    },
    {
      "id": "P2_RESET",
      "sva_name": "p_reset_state",
      "type": "next_cycle_implication",
      "natural_language": "reset returns the controller to its reset behavior",
      "antecedent": "rst",
      "consequent": "standby && !running && !faulted",
      "delay": 1
    },
    {
      "id": "P3_T1",
      "sva_name": "p_t1",
      "type": "next_cycle_implication",
      "natural_language": "STANDBY transitions to RUN when run",
      "antecedent": "(standby && !running && !faulted) && (run)",
      "consequent": "!standby && running && !faulted",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P4_T2",
      "sva_name": "p_t2",
      "type": "next_cycle_implication",
      "natural_language": "STANDBY transitions to STANDBY when !run",
      "antecedent": "(standby && !running && !faulted) && (!run)",
      "consequent": "standby && !running && !faulted",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_T3",
      "sva_name": "p_t3",
      "type": "next_cycle_implication",
      "natural_language": "RUN transitions to FAULT when fault",
      "antecedent": "(!standby && running && !faulted) && (fault)",
      "consequent": "!standby && !running && faulted",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P6_T4",
      "sva_name": "p_t4",
      "type": "next_cycle_implication",
      "natural_language": "RUN transitions to RUN when !fault && run",
      "antecedent": "(!standby && running && !faulted) && (!fault && run)",
      "consequent": "!standby && running && !faulted",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P7_T5",
      "sva_name": "p_t5",
      "type": "next_cycle_implication",
      "natural_language": "RUN transitions to STANDBY when !fault && !run",
      "antecedent": "(!standby && running && !faulted) && (!fault && !run)",
      "consequent": "standby && !running && !faulted",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P8_T6",
      "sva_name": "p_t6",
      "type": "next_cycle_implication",
      "natural_language": "FAULT transitions to STANDBY when clear",
      "antecedent": "(!standby && !running && faulted) && (clear)",
      "consequent": "standby && !running && !faulted",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P9_T7",
      "sva_name": "p_t7",
      "type": "next_cycle_implication",
      "natural_language": "FAULT transitions to FAULT when !clear",
      "antecedent": "(!standby && !running && faulted) && (!clear)",
      "consequent": "!standby && !running && faulted",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "drop_t1",
      "kind": "replace_transition_guard",
      "from": "STANDBY",
      "old": "run",
      "new": "false"
    },
    {
      "name": "drop_t2",
      "kind": "replace_transition_guard",
      "from": "STANDBY",
      "old": "!run",
      "new": "false"
    },
    {
      "name": "drop_t3",
      "kind": "replace_transition_guard",
      "from": "RUN",
      "old": "fault",
      "new": "false"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "programmatic_template_instantiation",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
