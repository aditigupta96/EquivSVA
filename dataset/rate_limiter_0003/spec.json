{
  "design_id": "rate_limiter_0003",
  "category": "rate_limiter",
  "model_type": "register_rules",
  "template": "token_consume_priority",
  "description": "Rate-control state implementing token consume priority.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true
  },
  "inputs": [
    "refill",
    "consume"
  ],
  "outputs": [
    "tokens",
    "allow",
    "full"
  ],
  "signal_widths": {
    "tokens": 3
  },
  "registers": [
    {
      "name": "tokens",
      "width": 3,
      "reset_value": "3'd4",
      "observable": true
    }
  ],
  "derived_outputs": {
    "allow": "tokens != 3'd0",
    "full": "tokens == 3'd7"
  },
  "update_rules": [
    {
      "when": "consume && (tokens > 3'd0)",
      "value": "tokens - 3'd1"
    },
    {
      "when": "!consume && refill && (tokens < 3'd7)",
      "value": "tokens + 3'd1"
    },
    {
      "when": "true",
      "value": "tokens"
    }
  ],
  "rtl_variants": [
    {
      "name": "canonical",
      "module_suffix": "canonical_next",
      "file": "canonical_next.sv"
    },
    {
      "name": "sequential",
      "module_suffix": "sequential_priority",
      "file": "sequential_priority.sv"
    },
    {
      "name": "ternary",
      "module_suffix": "ternary_next",
      "file": "ternary_next.sv"
    },
    {
      "name": "function",
      "module_suffix": "function_update",
      "file": "function_update.sv"
    }
  ],
  "notes": [
    "The state register is interface-visible and part of observable equivalence.",
    "All benchmark properties use interface-visible signals only."
  ],
  "properties": [
    {
      "id": "P1_RESET",
      "sva_name": "p_reset_value",
      "type": "next_cycle_implication",
      "natural_language": "reset restores the register to its reset value",
      "antecedent": "rst",
      "consequent": "tokens == 3'd4",
      "delay": 1
    },
    {
      "id": "P2_ALLOW",
      "sva_name": "p_allow",
      "type": "invariant",
      "natural_language": "allow is consistent with the observable register value",
      "expression": "allow == (tokens != 3'd0)",
      "disable": "rst"
    },
    {
      "id": "P3_FULL",
      "sva_name": "p_full",
      "type": "invariant",
      "natural_language": "full is consistent with the observable register value",
      "expression": "full == (tokens == 3'd7)",
      "disable": "rst"
    },
    {
      "id": "P4_RULE",
      "sva_name": "p_rule_4",
      "type": "next_cycle_implication",
      "natural_language": "update rule consume && (tokens > 3'd0) produces the specified next value",
      "antecedent": "consume && (tokens > 3'd0)",
      "consequent": "tokens == ($past(tokens) - 3'd1)",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_RULE",
      "sva_name": "p_rule_5",
      "type": "next_cycle_implication",
      "natural_language": "update rule !consume && refill && (tokens < 3'd7) produces the specified next value",
      "antecedent": "!consume && refill && (tokens < 3'd7)",
      "consequent": "tokens == ($past(tokens) + 3'd1)",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P6_HOLD",
      "sva_name": "p_hold",
      "type": "next_cycle_implication",
      "natural_language": "when no update rule fires the register holds its value",
      "antecedent": "!(consume && (tokens > 3'd0)) && !(!consume && refill && (tokens < 3'd7))",
      "consequent": "tokens == $past(tokens)",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "drop_first_rule",
      "kind": "replace_update_guard",
      "old": "consume && (tokens > 3'd0)",
      "new": "false"
    },
    {
      "name": "drop_second_rule",
      "kind": "replace_update_guard",
      "old": "!consume && refill && (tokens < 3'd7)",
      "new": "false"
    },
    {
      "name": "broaden_second_rule",
      "kind": "replace_update_guard",
      "old": "!consume && refill && (tokens < 3'd7)",
      "new": "true"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "programmatic_template_instantiation",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
