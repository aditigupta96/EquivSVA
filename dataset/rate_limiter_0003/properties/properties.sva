// Gold interface properties for rate_limiter_0003

// P1_RESET: reset restores the register to its reset value
property p_reset_value;
    @(posedge clk) (rst) |=> (tokens == 3'd4);
endproperty
assert property (p_reset_value);

// P2_ALLOW: allow is consistent with the observable register value
property p_allow;
    @(posedge clk) disable iff (rst) (allow == (tokens != 3'd0));
endproperty
assert property (p_allow);

// P3_FULL: full is consistent with the observable register value
property p_full;
    @(posedge clk) disable iff (rst) (full == (tokens == 3'd7));
endproperty
assert property (p_full);

// P4_RULE: update rule consume && (tokens > 3'd0) produces the specified next value
property p_rule_4;
    @(posedge clk) disable iff (rst) (consume && (tokens > 3'd0)) |=> (tokens == ($past(tokens) - 3'd1));
endproperty
assert property (p_rule_4);

// P5_RULE: update rule !consume && refill && (tokens < 3'd7) produces the specified next value
property p_rule_5;
    @(posedge clk) disable iff (rst) (!consume && refill && (tokens < 3'd7)) |=> (tokens == ($past(tokens) + 3'd1));
endproperty
assert property (p_rule_5);

// P6_HOLD: when no update rule fires the register holds its value
property p_hold;
    @(posedge clk) disable iff (rst) (!(consume && (tokens > 3'd0)) && !(!consume && refill && (tokens < 3'd7))) |=> (tokens == $past(tokens));
endproperty
assert property (p_hold);
