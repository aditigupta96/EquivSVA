[
  {
    "id": "P1_STATE_ENCODING",
    "type": "invariant",
    "natural_language": "observable state outputs always encode at most one active mode",
    "expression": "$onehot0({booting, ready, running})",
    "disable": "rst"
  },
  {
    "id": "P2_RESET",
    "type": "next_cycle_implication",
    "natural_language": "reset returns the controller to its reset behavior",
    "antecedent": "rst",
    "consequent": "booting && !ready && !running",
    "delay": 1
  },
  {
    "id": "P3_T1",
    "type": "next_cycle_implication",
    "natural_language": "BOOT transitions to READY when boot_ok",
    "antecedent": "(booting && !ready && !running) && (boot_ok)",
    "consequent": "!booting && ready && !running",
    "delay": 1,
    "disable": "rst"
  },
  {
    "id": "P4_T2",
    "type": "next_cycle_implication",
