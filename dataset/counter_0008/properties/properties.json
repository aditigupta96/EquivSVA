[
  {
    "id": "P1_RESET",
    "sva_name": "p_reset_value",
    "type": "next_cycle_implication",
    "natural_language": "reset restores the register to its reset value",
    "antecedent": "rst",
    "consequent": "count == 3'd0",
    "delay": 1
  },
  {
    "id": "P2_AT_LIMIT",
    "sva_name": "p_at_limit",
    "type": "invariant",
    "natural_language": "at_limit is consistent with the observable register value",
    "expression": "at_limit == (count == 3'd6)",
    "disable": "rst"
  },
  {
    "id": "P3_RULE",
    "sva_name": "p_rule_3",
    "type": "next_cycle_implication",
    "natural_language": "update rule clear produces the specified next value",
    "antecedent": "clear",
    "consequent": "count == (3'd0)",
    "delay": 1,
    "disable": "rst"
  },
  {
    "id": "P4_RULE",
    "sva_name": "p_rule_4",
    "type": "next_cycle_implication",
    "natural_language": "update rule !clear && step && (count < 3'd6) produces the specified next value",
    "antecedent": "!clear && step && (count < 3'd6)",
    "consequent": "count == ($past(count) + 3'd2)",
    "delay": 1,
    "disable": "rst"
  },
  {
    "id": "P5_HOLD",
    "sva_name": "p_hold",
    "type": "next_cycle_implication",
    "natural_language": "when no update rule fires the register holds its value",
    "antecedent": "!(clear) && !(!clear && step && (count < 3'd6))",
    "consequent": "count == $past(count)",
    "delay": 1,
    "disable": "rst"
  }
]
