[
  {
    "id": "P1_STATE_ENCODING",
    "type": "invariant",
    "natural_language": "observable state outputs always encode at most one active mode",
    "expression": "$onehot0({waiting_high, pulse, waiting_low})",
    "disable": "rst"
  },
  {
    "id": "P2_RESET",
    "type": "next_cycle_implication",
    "natural_language": "reset returns the controller to its reset behavior",
    "antecedent": "rst",
    "consequent": "waiting_high && !pulse && !waiting_low",
    "delay": 1
  },
  {
    "id": "P3_T1",
    "type": "next_cycle_implication",
    "natural_language": "WAIT_HIGH transitions to WAIT_LOW when event_in",
    "antecedent": "(waiting_high && !pulse && !waiting_low) && (event_in)",
    "consequent": "!waiting_high && !pulse && waiting_low",
    "delay": 1,
    "disable": "rst"
  },
  {
    "id": "P4_T2",
    "type": "next_cycle_implication",
    "natural_language": "WAIT_HIGH transitions to WAIT_HIGH when !event_in",
    "antecedent": "(waiting_high && !pulse && !waiting_low) && (!event_in)",
    "consequent": "waiting_high && !pulse && !waiting_low",
    "delay": 1,
    "disable": "rst"
  },
  {
    "id": "P5_T3",
    "type": "next_cycle_implication",
    "natural_language": "WAIT_LOW transitions to PULSE when !event_in",
    "antecedent": "(!waiting_high && !pulse && waiting_low) && (!event_in)",
    "consequent": "!waiting_high && pulse && !waiting_low",
    "delay": 1,
    "disable": "rst"
  },
  {
    "id": "P6_T4",
    "type": "next_cycle_implication",
    "natural_language": "WAIT_LOW transitions to WAIT_LOW when event_in",
    "antecedent": "(!waiting_high && !pulse && waiting_low) && (event_in)",
    "consequent": "!waiting_high && !pulse && waiting_low",
    "delay": 1,
    "disable": "rst"
  },
  {
    "id": "P7_T5",
    "type": "next_cycle_implication",
    "natural_language": "PULSE transitions to WAIT_HIGH when true",
    "antecedent": "!waiting_high && pulse && !waiting_low",
    "consequent": "waiting_high && !pulse && !waiting_low",
    "delay": 1,
    "disable": "rst"
  }
