{
  "design_id": "pulse_event_0003",
  "category": "pulse_event",
  "template": "falling_rearm",
  "description": "Pulse/event controller implementing falling rearm semantics.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true,
    "state": "WAIT_HIGH"
  },
  "inputs": [
    "event_in"
  ],
  "outputs": [
    "waiting_high",
    "pulse",
    "waiting_low"
  ],
  "states": [
    "WAIT_HIGH",
    "PULSE",
    "WAIT_LOW"
  ],
  "state_outputs": {
    "WAIT_HIGH": {
      "waiting_high": 1,
      "pulse": 0,
      "waiting_low": 0
    },
    "PULSE": {
      "waiting_high": 0,
      "pulse": 1,
      "waiting_low": 0
    },
    "WAIT_LOW": {
      "waiting_high": 0,
      "pulse": 0,
      "waiting_low": 1
    }
  },
  "transitions": [
    {
      "from": "WAIT_HIGH",
      "when": "event_in",
      "to": "WAIT_LOW"
    },
    {
      "from": "WAIT_HIGH",
      "when": "!event_in",
      "to": "WAIT_HIGH"
    },
    {
      "from": "WAIT_LOW",
      "when": "!event_in",
      "to": "PULSE"
    },
    {
      "from": "WAIT_LOW",
      "when": "event_in",
      "to": "WAIT_LOW"
    },
    {
      "from": "PULSE",
      "when": "true",
      "to": "WAIT_HIGH"
    }
  ],
  "rtl_variants": [
    "canonical_case",
    "onehot_case",
    "nested_if",
    "factored_flags"
  ],
  "notes": [
    "All benchmark properties use interface-visible signals only.",
    "All RTL variants must be observationally equivalent after reset."
  ],
  "properties": [
    {
      "id": "P1_STATE_ENCODING",
      "sva_name": "p_state_encoding",
      "type": "invariant",
      "natural_language": "observable state outputs always encode at most one active mode",
      "expression": "$onehot0({waiting_high, pulse, waiting_low})",
      "disable": "rst"
    },
    {
      "id": "P2_RESET",
      "sva_name": "p_reset_state",
      "type": "next_cycle_implication",
      "natural_language": "reset returns the controller to its reset behavior",
      "antecedent": "rst",
      "consequent": "waiting_high && !pulse && !waiting_low",
      "delay": 1
    },
    {
      "id": "P3_T1",
      "sva_name": "p_t1",
      "type": "next_cycle_implication",
      "natural_language": "WAIT_HIGH transitions to WAIT_LOW when event_in",
      "antecedent": "(waiting_high && !pulse && !waiting_low) && (event_in)",
      "consequent": "!waiting_high && !pulse && waiting_low",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P4_T2",
      "sva_name": "p_t2",
      "type": "next_cycle_implication",
      "natural_language": "WAIT_HIGH transitions to WAIT_HIGH when !event_in",
      "antecedent": "(waiting_high && !pulse && !waiting_low) && (!event_in)",
      "consequent": "waiting_high && !pulse && !waiting_low",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_T3",
      "sva_name": "p_t3",
      "type": "next_cycle_implication",
      "natural_language": "WAIT_LOW transitions to PULSE when !event_in",
      "antecedent": "(!waiting_high && !pulse && waiting_low) && (!event_in)",
      "consequent": "!waiting_high && pulse && !waiting_low",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P6_T4",
      "sva_name": "p_t4",
      "type": "next_cycle_implication",
      "natural_language": "WAIT_LOW transitions to WAIT_LOW when event_in",
      "antecedent": "(!waiting_high && !pulse && waiting_low) && (event_in)",
      "consequent": "!waiting_high && !pulse && waiting_low",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P7_T5",
      "sva_name": "p_t5",
      "type": "next_cycle_implication",
      "natural_language": "PULSE transitions to WAIT_HIGH when true",
      "antecedent": "!waiting_high && pulse && !waiting_low",
      "consequent": "waiting_high && !pulse && !waiting_low",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "drop_t1",
      "kind": "replace_transition_guard",
      "from": "WAIT_HIGH",
      "old": "event_in",
      "new": "false"
    },
    {
      "name": "drop_t2",
      "kind": "replace_transition_guard",
      "from": "WAIT_HIGH",
      "old": "!event_in",
      "new": "false"
    },
    {
      "name": "drop_t3",
      "kind": "replace_transition_guard",
      "from": "WAIT_LOW",
      "old": "!event_in",
      "new": "false"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "programmatic_template_instantiation",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
