  {
    "id": "P1_MUTUAL_EXCLUSION",
    "type": "invariant",
    "natural_language": "at most one requester is granted at a time",
    "disable": "rst",
    "expression": "!((grant0 && grant1) || (grant0 && grant2) || (grant1 && grant2))"
  },
  {
    "id": "P2_RESET_NO_GRANT",
