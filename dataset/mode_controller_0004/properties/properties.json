    "consequent": "running && !safe && !faulted",
    "delay": 1,
    "disable": "rst"
  },
  {
    "id": "P7_T5",
    "type": "next_cycle_implication",
    "natural_language": "FAULT transitions to SAFE when clear",
    "antecedent": "(!running && !safe && faulted) && (clear)",
    "consequent": "!running && safe && !faulted",
    "delay": 1,
    "disable": "rst"
  },
  {
    "id": "P8_T6",
    "type": "next_cycle_implication",
    "natural_language": "FAULT transitions to FAULT when !clear",
    "antecedent": "(!running && !safe && faulted) && (!clear)",
    "consequent": "!running && !safe && faulted",
