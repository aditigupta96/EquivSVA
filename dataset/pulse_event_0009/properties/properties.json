    "delay": 1,
    "disable": "rst"
  },
  {
    "id": "P6_T4",
    "type": "next_cycle_implication",
    "natural_language": "WAIT transitions to WAIT when !complete",
    "antecedent": "(waiting && !pulse && !idle) && (!complete)",
    "consequent": "waiting && !pulse && !idle",
    "delay": 1,
    "disable": "rst"
  },
  {
    "id": "P7_T5",
    "type": "next_cycle_implication",
    "natural_language": "PULSE transitions to IDLE when true",
    "antecedent": "!waiting && pulse && !idle",
    "consequent": "!waiting && !pulse && idle",
    "delay": 1,
    "disable": "rst"
  }
