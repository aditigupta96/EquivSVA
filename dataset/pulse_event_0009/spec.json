{
  "design_id": "pulse_event_0009",
  "category": "pulse_event",
  "template": "request_complete_pulse",
  "description": "Pulse/event controller implementing request complete pulse semantics.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true,
    "state": "IDLE"
  },
  "inputs": [
    "request",
    "complete"
  ],
  "outputs": [
    "waiting",
    "pulse",
    "idle"
  ],
  "states": [
    "IDLE",
    "WAIT",
    "PULSE"
  ],
  "state_outputs": {
    "IDLE": {
      "waiting": 0,
      "pulse": 0,
      "idle": 1
    },
    "WAIT": {
      "waiting": 1,
      "pulse": 0,
      "idle": 0
    },
    "PULSE": {
      "waiting": 0,
      "pulse": 1,
      "idle": 0
    }
  },
  "transitions": [
    {
      "from": "IDLE",
      "when": "request",
      "to": "WAIT"
    },
    {
      "from": "IDLE",
      "when": "!request",
      "to": "IDLE"
    },
    {
      "from": "WAIT",
      "when": "complete",
      "to": "PULSE"
    },
    {
      "from": "WAIT",
      "when": "!complete",
      "to": "WAIT"
    },
    {
      "from": "PULSE",
      "when": "true",
      "to": "IDLE"
    }
  ],
  "rtl_variants": [
    "canonical_case",
    "onehot_case",
    "nested_if",
    "factored_flags"
  ],
  "notes": [
    "All benchmark properties use interface-visible signals only.",
    "All RTL variants must be observationally equivalent after reset."
  ],
  "properties": [
    {
      "id": "P1_STATE_ENCODING",
      "sva_name": "p_state_encoding",
      "type": "invariant",
      "natural_language": "observable state outputs always encode at most one active mode",
      "expression": "$onehot0({waiting, pulse, idle})",
      "disable": "rst"
    },
    {
      "id": "P2_RESET",
      "sva_name": "p_reset_state",
      "type": "next_cycle_implication",
      "natural_language": "reset returns the controller to its reset behavior",
      "antecedent": "rst",
      "consequent": "!waiting && !pulse && idle",
      "delay": 1
    },
    {
      "id": "P3_T1",
      "sva_name": "p_t1",
      "type": "next_cycle_implication",
      "natural_language": "IDLE transitions to WAIT when request",
      "antecedent": "(!waiting && !pulse && idle) && (request)",
      "consequent": "waiting && !pulse && !idle",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P4_T2",
      "sva_name": "p_t2",
      "type": "next_cycle_implication",
      "natural_language": "IDLE transitions to IDLE when !request",
      "antecedent": "(!waiting && !pulse && idle) && (!request)",
      "consequent": "!waiting && !pulse && idle",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_T3",
      "sva_name": "p_t3",
      "type": "next_cycle_implication",
      "natural_language": "WAIT transitions to PULSE when complete",
      "antecedent": "(waiting && !pulse && !idle) && (complete)",
      "consequent": "!waiting && pulse && !idle",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P6_T4",
      "sva_name": "p_t4",
      "type": "next_cycle_implication",
      "natural_language": "WAIT transitions to WAIT when !complete",
      "antecedent": "(waiting && !pulse && !idle) && (!complete)",
      "consequent": "waiting && !pulse && !idle",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P7_T5",
      "sva_name": "p_t5",
      "type": "next_cycle_implication",
      "natural_language": "PULSE transitions to IDLE when true",
      "antecedent": "!waiting && pulse && !idle",
      "consequent": "!waiting && !pulse && idle",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "drop_t1",
      "kind": "replace_transition_guard",
      "from": "IDLE",
      "old": "request",
      "new": "false"
    },
    {
      "name": "drop_t2",
      "kind": "replace_transition_guard",
      "from": "IDLE",
      "old": "!request",
      "new": "false"
    },
    {
      "name": "drop_t3",
      "kind": "replace_transition_guard",
      "from": "WAIT",
      "old": "complete",
      "new": "false"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "programmatic_template_instantiation",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
