{
  "design_id": "rate_limiter_0008",
  "category": "rate_limiter",
  "model_type": "register_rules",
  "template": "leaky_budget",
  "description": "Rate-control state implementing leaky budget.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true
  },
  "inputs": [
    "add",
    "leak"
  ],
  "outputs": [
    "level",
    "blocked"
  ],
  "signal_widths": {
    "level": 3
  },
  "registers": [
    {
      "name": "level",
      "width": 3,
      "reset_value": "3'd0",
      "observable": true
    }
  ],
  "derived_outputs": {
    "blocked": "level == 3'd7"
  },
  "update_rules": [
    {
      "when": "add && (level < 3'd7)",
      "value": "level + 3'd1"
    },
    {
      "when": "!add && leak && (level > 3'd0)",
      "value": "level - 3'd1"
    },
    {
      "when": "true",
      "value": "level"
    }
  ],
  "rtl_variants": [
    {
      "name": "canonical",
      "module_suffix": "canonical_next",
      "file": "canonical_next.sv"
    },
    {
      "name": "sequential",
      "module_suffix": "sequential_priority",
      "file": "sequential_priority.sv"
    },
    {
      "name": "ternary",
      "module_suffix": "ternary_next",
      "file": "ternary_next.sv"
    },
    {
      "name": "function",
      "module_suffix": "function_update",
      "file": "function_update.sv"
    }
  ],
  "notes": [
    "The state register is interface-visible and part of observable equivalence.",
    "All benchmark properties use interface-visible signals only."
  ],
  "properties": [
    {
      "id": "P1_RESET",
      "sva_name": "p_reset_value",
      "type": "next_cycle_implication",
      "natural_language": "reset restores the register to its reset value",
      "antecedent": "rst",
      "consequent": "level == 3'd0",
      "delay": 1
    },
    {
      "id": "P2_BLOCKED",
      "sva_name": "p_blocked",
      "type": "invariant",
      "natural_language": "blocked is consistent with the observable register value",
      "expression": "blocked == (level == 3'd7)",
      "disable": "rst"
    },
    {
      "id": "P3_RULE",
      "sva_name": "p_rule_3",
      "type": "next_cycle_implication",
      "natural_language": "update rule add && (level < 3'd7) produces the specified next value",
      "antecedent": "add && (level < 3'd7)",
      "consequent": "level == ($past(level) + 3'd1)",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P4_RULE",
      "sva_name": "p_rule_4",
      "type": "next_cycle_implication",
      "natural_language": "update rule !add && leak && (level > 3'd0) produces the specified next value",
      "antecedent": "!add && leak && (level > 3'd0)",
      "consequent": "level == ($past(level) - 3'd1)",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_HOLD",
      "sva_name": "p_hold",
      "type": "next_cycle_implication",
      "natural_language": "when no update rule fires the register holds its value",
      "antecedent": "!(add && (level < 3'd7)) && !(!add && leak && (level > 3'd0))",
      "consequent": "level == $past(level)",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "drop_first_rule",
      "kind": "replace_update_guard",
      "old": "add && (level < 3'd7)",
      "new": "false"
    },
    {
      "name": "drop_second_rule",
      "kind": "replace_update_guard",
      "old": "!add && leak && (level > 3'd0)",
      "new": "false"
    },
    {
      "name": "broaden_second_rule",
      "kind": "replace_update_guard",
      "old": "!add && leak && (level > 3'd0)",
      "new": "true"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "programmatic_template_instantiation",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
