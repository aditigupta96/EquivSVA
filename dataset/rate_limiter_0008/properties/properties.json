[
  {
    "id": "P1_RESET",
    "sva_name": "p_reset_value",
    "type": "next_cycle_implication",
    "natural_language": "reset restores the register to its reset value",
    "antecedent": "rst",
    "consequent": "level == 3'd0",
    "delay": 1
  },
  {
    "id": "P2_BLOCKED",
    "sva_name": "p_blocked",
    "type": "invariant",
    "natural_language": "blocked is consistent with the observable register value",
    "expression": "blocked == (level == 3'd7)",
    "disable": "rst"
  },
  {
    "id": "P3_RULE",
    "sva_name": "p_rule_3",
    "type": "next_cycle_implication",
    "natural_language": "update rule add && (level < 3'd7) produces the specified next value",
    "antecedent": "add && (level < 3'd7)",
    "consequent": "level == ($past(level) + 3'd1)",
    "delay": 1,
    "disable": "rst"
  },
  {
    "id": "P4_RULE",
    "sva_name": "p_rule_4",
    "type": "next_cycle_implication",
    "natural_language": "update rule !add && leak && (level > 3'd0) produces the specified next value",
    "antecedent": "!add && leak && (level > 3'd0)",
    "consequent": "level == ($past(level) - 3'd1)",
    "delay": 1,
    "disable": "rst"
  },
  {
    "id": "P5_HOLD",
    "sva_name": "p_hold",
    "type": "next_cycle_implication",
    "natural_language": "when no update rule fires the register holds its value",
    "antecedent": "!(add && (level < 3'd7)) && !(!add && leak && (level > 3'd0))",
    "consequent": "level == $past(level)",
    "delay": 1,
    "disable": "rst"
  }
]
