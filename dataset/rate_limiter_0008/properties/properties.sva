// Gold interface properties for rate_limiter_0008

// P1_RESET: reset restores the register to its reset value
property p_reset_value;
    @(posedge clk) (rst) |=> (level == 3'd0);
endproperty
assert property (p_reset_value);

// P2_BLOCKED: blocked is consistent with the observable register value
property p_blocked;
    @(posedge clk) disable iff (rst) (blocked == (level == 3'd7));
endproperty
assert property (p_blocked);

// P3_RULE: update rule add && (level < 3'd7) produces the specified next value
property p_rule_3;
    @(posedge clk) disable iff (rst) (add && (level < 3'd7)) |=> (level == ($past(level) + 3'd1));
endproperty
assert property (p_rule_3);

// P4_RULE: update rule !add && leak && (level > 3'd0) produces the specified next value
property p_rule_4;
    @(posedge clk) disable iff (rst) (!add && leak && (level > 3'd0)) |=> (level == ($past(level) - 3'd1));
endproperty
assert property (p_rule_4);

// P5_HOLD: when no update rule fires the register holds its value
property p_hold;
    @(posedge clk) disable iff (rst) (!(add && (level < 3'd7)) && !(!add && leak && (level > 3'd0))) |=> (level == $past(level));
endproperty
assert property (p_hold);
