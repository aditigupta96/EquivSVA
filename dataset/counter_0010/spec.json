{
  "design_id": "counter_0010",
  "category": "counter",
  "model_type": "register_rules",
  "template": "priority_load_counter",
  "description": "Loadable counter where load has priority over increment.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true
  },
  "inputs": [
    "load",
    "increment"
  ],
  "outputs": [
    "count",
    "nonzero"
  ],
  "signal_widths": {
    "count": 3
  },
  "registers": [
    {
      "name": "count",
      "width": 3,
      "reset_value": "3'd0",
      "observable": true
    }
  ],
  "derived_outputs": {
    "nonzero": "count != 3'd0"
  },
  "update_rules": [
    {
      "when": "load",
      "value": "3'd4"
    },
    {
      "when": "!load && increment && (count < 3'd7)",
      "value": "count + 3'd1"
    },
    {
      "when": "true",
      "value": "count"
    }
  ],
  "rtl_variants": [
    {
      "name": "canonical",
      "module_suffix": "canonical_next",
      "file": "canonical_next.sv"
    },
    {
      "name": "sequential",
      "module_suffix": "sequential_priority",
      "file": "sequential_priority.sv"
    },
    {
      "name": "ternary",
      "module_suffix": "ternary_next",
      "file": "ternary_next.sv"
    },
    {
      "name": "function",
      "module_suffix": "function_update",
      "file": "function_update.sv"
    }
  ],
  "notes": [
    "The state register is interface-visible and part of observable equivalence.",
    "All benchmark properties use interface-visible signals only."
  ],
  "properties": [
    {
      "id": "P1_RESET",
      "sva_name": "p_reset_value",
      "type": "next_cycle_implication",
      "natural_language": "reset restores the register to its reset value",
      "antecedent": "rst",
      "consequent": "count == 3'd0",
      "delay": 1
    },
    {
      "id": "P2_NONZERO",
      "sva_name": "p_nonzero",
      "type": "invariant",
      "natural_language": "nonzero is consistent with the observable register value",
      "expression": "nonzero == (count != 3'd0)",
      "disable": "rst"
    },
    {
      "id": "P3_RULE",
      "sva_name": "p_rule_3",
      "type": "next_cycle_implication",
      "natural_language": "update rule load produces the specified next value",
      "antecedent": "load",
      "consequent": "count == (3'd4)",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P4_RULE",
      "sva_name": "p_rule_4",
      "type": "next_cycle_implication",
      "natural_language": "update rule !load && increment && (count < 3'd7) produces the specified next value",
      "antecedent": "!load && increment && (count < 3'd7)",
      "consequent": "count == ($past(count) + 3'd1)",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_HOLD",
      "sva_name": "p_hold",
      "type": "next_cycle_implication",
      "natural_language": "when no update rule fires the register holds its value",
      "antecedent": "!(load) && !(!load && increment && (count < 3'd7))",
      "consequent": "count == $past(count)",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "ignore_load",
      "kind": "replace_update_guard",
      "old": "load",
      "new": "false"
    },
    {
      "name": "ignore_increment",
      "kind": "replace_update_guard",
      "old": "!load && increment && (count < 3'd7)",
      "new": "false"
    },
    {
      "name": "increment_beats_load",
      "kind": "replace_update_guard",
      "old": "!load && increment && (count < 3'd7)",
      "new": "increment && (count < 3'd7)"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "programmatic_template_instantiation",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
