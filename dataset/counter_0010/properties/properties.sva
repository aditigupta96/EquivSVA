// Gold interface properties for counter_0010

// P1_RESET: reset restores the register to its reset value
property p_reset_value;
    @(posedge clk) (rst) |=> (count == 3'd0);
endproperty
assert property (p_reset_value);

// P2_NONZERO: nonzero is consistent with the observable register value
property p_nonzero;
    @(posedge clk) disable iff (rst) (nonzero == (count != 3'd0));
endproperty
assert property (p_nonzero);

// P3_RULE: update rule load produces the specified next value
property p_rule_3;
    @(posedge clk) disable iff (rst) (load) |=> (count == (3'd4));
endproperty
assert property (p_rule_3);

// P4_RULE: update rule !load && increment && (count < 3'd7) produces the specified next value
property p_rule_4;
    @(posedge clk) disable iff (rst) (!load && increment && (count < 3'd7)) |=> (count == ($past(count) + 3'd1));
endproperty
assert property (p_rule_4);

// P5_HOLD: when no update rule fires the register holds its value
property p_hold;
    @(posedge clk) disable iff (rst) (!(load) && !(!load && increment && (count < 3'd7))) |=> (count == $past(count));
endproperty
assert property (p_hold);
