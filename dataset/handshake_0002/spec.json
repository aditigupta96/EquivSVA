{
  "design_id": "handshake_0002",
  "category": "handshake",
  "template": "request_done_ack",
  "description": "A request starts an operation. The controller remains busy until done is observed, acknowledges completion for one cycle, then returns to idle.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "state": "IDLE"
  },
  "inputs": [
    "req",
    "done"
  ],
  "outputs": [
    "busy",
    "ack"
  ],
  "states": [
    "IDLE",
    "BUSY",
    "ACK"
  ],
  "state_outputs": {
    "IDLE": {
      "busy": 0,
      "ack": 0
    },
    "BUSY": {
      "busy": 1,
      "ack": 0
    },
    "ACK": {
      "busy": 0,
      "ack": 1
    }
  },
  "transitions": [
    {
      "from": "IDLE",
      "when": "req",
      "to": "BUSY"
    },
    {
      "from": "IDLE",
      "when": "true",
      "to": "IDLE"
    },
    {
      "from": "BUSY",
      "when": "done",
      "to": "ACK"
    },
    {
      "from": "BUSY",
      "when": "true",
      "to": "BUSY"
    },
    {
      "from": "ACK",
      "when": "true",
      "to": "IDLE"
    }
  ],
  "properties": [
    {
      "id": "P1_MUTEX",
      "sva_name": "p_mutex",
      "type": "invariant",
      "natural_language": "busy and ack are never asserted together",
      "disable": "rst",
      "expression": "!(busy && ack)"
    },
    {
      "id": "P2_RESET_IDLE",
      "sva_name": "p_reset_idle",
      "type": "next_cycle_implication",
      "natural_language": "reset returns the controller to idle",
      "antecedent": "rst",
      "consequent": "!busy && !ack",
      "delay": 1
    },
    {
      "id": "P3_REQUEST_TO_BUSY",
      "sva_name": "p_request_to_busy",
      "type": "next_cycle_implication",
      "natural_language": "a request presented while idle starts an operation",
      "disable": "rst",
      "antecedent": "(!busy && !ack) && req",
      "consequent": "busy",
      "delay": 1
    },
    {
      "id": "P4_IDLE_STAYS_IDLE",
      "sva_name": "p_idle_stays_idle",
      "type": "next_cycle_implication",
      "natural_language": "an idle controller remains idle without a request",
      "disable": "rst",
      "antecedent": "(!busy && !ack) && !req",
      "consequent": "!busy && !ack",
      "delay": 1
    },
    {
      "id": "P5_DONE_TO_ACK",
      "sva_name": "p_done_to_ack",
      "type": "next_cycle_implication",
      "natural_language": "completion while busy produces an acknowledgement",
      "disable": "rst",
      "antecedent": "busy && done",
      "consequent": "ack",
      "delay": 1
    },
    {
      "id": "P6_BUSY_HOLDS",
      "sva_name": "p_busy_holds",
      "type": "next_cycle_implication",
      "natural_language": "the controller remains busy until completion",
      "disable": "rst",
      "antecedent": "busy && !done",
      "consequent": "busy",
      "delay": 1
    },
    {
      "id": "P7_ACK_TO_IDLE",
      "sva_name": "p_ack_to_idle",
      "type": "next_cycle_implication",
      "natural_language": "acknowledgement lasts one cycle before returning idle",
      "disable": "rst",
      "antecedent": "ack",
      "consequent": "!busy && !ack",
      "delay": 1
    }
  ],
  "mutants": [
    {
      "name": "spurious_start",
      "kind": "replace_transition_guard",
      "from": "IDLE",
      "old": "req",
      "new": "true"
    },
    {
      "name": "premature_ack",
      "kind": "force_transition",
      "from": "BUSY",
      "to": "ACK"
    },
    {
      "name": "ack_stuck",
      "kind": "force_transition",
      "from": "ACK",
      "to": "ACK"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "manually_authored",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
