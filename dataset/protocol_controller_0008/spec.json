{
  "design_id": "protocol_controller_0008",
  "category": "protocol_controller",
  "template": "open_auth_transfer_close",
  "description": "Session protocol opens, authenticates, transfers, closes, then signals completion.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true,
    "state": "OPEN"
  },
  "inputs": [
    "open_ok",
    "auth_ok",
    "transfer_done",
    "close_ok",
    "abort"
  ],
  "outputs": [
    "opening",
    "authenticating",
    "transferring",
    "closing",
    "done",
    "failed"
  ],
  "states": [
    "OPEN",
    "AUTH",
    "TRANSFER",
    "CLOSE",
    "DONE",
    "FAILED"
  ],
  "state_outputs": {
    "OPEN": {
      "opening": 1,
      "authenticating": 0,
      "transferring": 0,
      "closing": 0,
      "done": 0,
      "failed": 0
    },
    "AUTH": {
      "opening": 0,
      "authenticating": 1,
      "transferring": 0,
      "closing": 0,
      "done": 0,
      "failed": 0
    },
    "TRANSFER": {
      "opening": 0,
      "authenticating": 0,
      "transferring": 1,
      "closing": 0,
      "done": 0,
      "failed": 0
    },
    "CLOSE": {
      "opening": 0,
      "authenticating": 0,
      "transferring": 0,
      "closing": 1,
      "done": 0,
      "failed": 0
    },
    "DONE": {
      "opening": 0,
      "authenticating": 0,
      "transferring": 0,
      "closing": 0,
      "done": 1,
      "failed": 0
    },
    "FAILED": {
      "opening": 0,
      "authenticating": 0,
      "transferring": 0,
      "closing": 0,
      "done": 0,
      "failed": 1
    }
  },
  "transitions": [
    {
      "from": "OPEN",
      "when": "abort",
      "to": "FAILED"
    },
    {
      "from": "OPEN",
      "when": "!abort && open_ok",
      "to": "AUTH"
    },
    {
      "from": "OPEN",
      "when": "!abort && !open_ok",
      "to": "OPEN"
    },
    {
      "from": "AUTH",
      "when": "abort",
      "to": "FAILED"
    },
    {
      "from": "AUTH",
      "when": "!abort && auth_ok",
      "to": "TRANSFER"
    },
    {
      "from": "AUTH",
      "when": "!abort && !auth_ok",
      "to": "AUTH"
    },
    {
      "from": "TRANSFER",
      "when": "abort",
      "to": "FAILED"
    },
    {
      "from": "TRANSFER",
      "when": "!abort && transfer_done",
      "to": "CLOSE"
    },
    {
      "from": "TRANSFER",
      "when": "!abort && !transfer_done",
      "to": "TRANSFER"
    },
    {
      "from": "CLOSE",
      "when": "abort",
      "to": "FAILED"
    },
    {
      "from": "CLOSE",
      "when": "!abort && close_ok",
      "to": "DONE"
    },
    {
      "from": "CLOSE",
      "when": "!abort && !close_ok",
      "to": "CLOSE"
    },
    {
      "from": "DONE",
      "when": "true",
      "to": "OPEN"
    },
    {
      "from": "FAILED",
      "when": "true",
      "to": "OPEN"
    }
  ],
  "rtl_variants": [
    "canonical_case",
    "onehot_case",
    "nested_if",
    "factored_flags"
  ],
  "notes": [
    "All benchmark properties use interface-visible signals only.",
    "All RTL variants must be observationally equivalent after reset."
  ],
  "properties": [
    {
      "id": "P1_ONEHOT",
      "sva_name": "p_onehot",
      "type": "invariant",
      "natural_language": "session phases are mutually exclusive",
      "expression": "$onehot({opening, authenticating, transferring, closing, done, failed})",
      "disable": "rst"
    },
    {
      "id": "P2_RESET",
      "sva_name": "p_reset",
      "type": "next_cycle_implication",
      "natural_language": "reset begins in opening phase",
      "antecedent": "rst",
      "consequent": "opening",
      "delay": 1
    },
    {
      "id": "P3_OPEN",
      "sva_name": "p_open",
      "type": "next_cycle_implication",
      "natural_language": "successful open advances to authentication",
      "antecedent": "opening && open_ok && !abort",
      "consequent": "authenticating",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P4_AUTH",
      "sva_name": "p_auth",
      "type": "next_cycle_implication",
      "natural_language": "successful authentication begins transfer",
      "antecedent": "authenticating && auth_ok && !abort",
      "consequent": "transferring",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_TRANSFER",
      "sva_name": "p_transfer",
      "type": "next_cycle_implication",
      "natural_language": "completed transfer enters closing",
      "antecedent": "transferring && transfer_done && !abort",
      "consequent": "closing",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P6_CLOSE",
      "sva_name": "p_close",
      "type": "next_cycle_implication",
      "natural_language": "successful close completes the session",
      "antecedent": "closing && close_ok && !abort",
      "consequent": "done",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P7_ABORT",
      "sva_name": "p_abort",
      "type": "next_cycle_implication",
      "natural_language": "abort from an active phase produces failure",
      "antecedent": "(opening || authenticating || transferring || closing) && abort",
      "consequent": "failed",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "ignore_auth",
      "kind": "replace_transition_guard",
      "from": "AUTH",
      "old": "!abort && auth_ok",
      "new": "false"
    },
    {
      "name": "ignore_transfer_done",
      "kind": "replace_transition_guard",
      "from": "TRANSFER",
      "old": "!abort && transfer_done",
      "new": "false"
    },
    {
      "name": "ignore_close",
      "kind": "replace_transition_guard",
      "from": "CLOSE",
      "old": "!abort && close_ok",
      "new": "false"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "manually_authored",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
