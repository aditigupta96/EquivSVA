{
  "design_id": "fifo_0001",
  "category": "fifo_control",
  "model_type": "multi_register_rules",
  "template": "elastic_single_entry_fifo",
  "description": "One-entry elastic FIFO allowing simultaneous pop and replacement push.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true
  },
  "inputs": [
    "push",
    "pop",
    "din"
  ],
  "outputs": [
    "dout",
    "valid",
    "ready"
  ],
  "signal_widths": {
    "din": 2,
    "dout": 2
  },
  "registers": [
    {
      "name": "data_reg",
      "width": 2,
      "reset_value": "2'd0"
    },
    {
      "name": "valid_reg",
      "width": 1,
      "reset_value": "1'b0"
    }
  ],
  "rtl_variants": [
    {
      "name": "canonical",
      "module_suffix": "canonical_next",
      "file": "canonical_next.sv"
    },
    {
      "name": "sequential",
      "module_suffix": "sequential_priority",
      "file": "sequential_priority.sv"
    },
    {
      "name": "ternary",
      "module_suffix": "ternary_next",
      "file": "ternary_next.sv"
    },
    {
      "name": "function",
      "module_suffix": "function_update",
      "file": "function_update.sv"
    }
  ],
  "notes": [
    "Properties use interface-visible behavior.",
    "All variants must be observationally equivalent."
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "manually_authored",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  },
  "derived_outputs": {
    "dout": "data_reg",
    "valid": "valid_reg",
    "ready": "!valid_reg || pop"
  },
  "update_rules": {
    "data_reg": [
      {
        "when": "push && (!valid_reg || pop)",
        "value": "din"
      },
      {
        "when": "true",
        "value": "data_reg"
      }
    ],
    "valid_reg": [
      {
        "when": "push && (!valid_reg || pop)",
        "value": "1'b1"
      },
      {
        "when": "pop && valid_reg",
        "value": "1'b0"
      },
      {
        "when": "true",
        "value": "valid_reg"
      }
    ]
  },
  "properties": [
    {
      "id": "P1_READY",
      "sva_name": "p_ready",
      "type": "invariant",
      "natural_language": "ready reflects whether a push can be accepted",
      "disable": "rst",
      "expression": "ready == (!valid || pop)"
    },
    {
      "id": "P2_RESET_EMPTY",
      "sva_name": "p_reset_empty",
      "type": "next_cycle_implication",
      "natural_language": "reset leaves the buffer empty",
      "antecedent": "rst",
      "consequent": "!valid",
      "delay": 1
    },
    {
      "id": "P3_EMPTY_PUSH",
      "sva_name": "p_empty_push",
      "type": "next_cycle_implication",
      "natural_language": "a push into an empty buffer captures the item",
      "disable": "rst",
      "antecedent": "!valid && push",
      "consequent": "valid && (dout == $past(din))",
      "delay": 1
    },
    {
      "id": "P4_BACKPRESSURE",
      "sva_name": "p_backpressure",
      "type": "next_cycle_implication",
      "natural_language": "a full buffer without pop cannot be overwritten",
      "disable": "rst",
      "antecedent": "valid && !pop && push",
      "consequent": "valid && (dout == $past(dout))",
      "delay": 1
    },
    {
      "id": "P5_POP_EMPTY",
      "sva_name": "p_pop_empty",
      "type": "next_cycle_implication",
      "natural_language": "a pop without replacement empties the buffer",
      "disable": "rst",
      "antecedent": "valid && pop && !push",
      "consequent": "!valid",
      "delay": 1
    },
    {
      "id": "P6_REPLACE",
      "sva_name": "p_replace",
      "type": "next_cycle_implication",
      "natural_language": "simultaneous pop and push replaces the buffered item",
      "disable": "rst",
      "antecedent": "valid && pop && push",
      "consequent": "valid && (dout == $past(din))",
      "delay": 1
    }
  ],
  "mutants": [
    {
      "name": "ignore_pop",
      "register": "valid_reg",
      "kind": "replace_update_guard",
      "old": "pop && valid_reg",
      "new": "false"
    },
    {
      "name": "drop_replacement",
      "register": "valid_reg",
      "kind": "replace_update_guard",
      "old": "push && (!valid_reg || pop)",
      "new": "push && !valid_reg"
    },
    {
      "name": "overwrite_full",
      "register": "data_reg",
      "kind": "replace_update_guard",
      "old": "push && (!valid_reg || pop)",
      "new": "push"
    }
  ]
}
