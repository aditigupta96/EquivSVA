{
  "design_id": "rate_limiter_0005",
  "category": "rate_limiter",
  "model_type": "register_rules",
  "template": "cooldown_budget",
  "description": "Rate-control state implementing cooldown budget.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true
  },
  "inputs": [
    "grant",
    "recover"
  ],
  "outputs": [
    "budget",
    "allow"
  ],
  "signal_widths": {
    "budget": 3
  },
  "registers": [
    {
      "name": "budget",
      "width": 3,
      "reset_value": "3'd7",
      "observable": true
    }
  ],
  "derived_outputs": {
    "allow": "budget != 3'd0"
  },
  "update_rules": [
    {
      "when": "recover && (budget < 3'd7)",
      "value": "budget + 3'd1"
    },
    {
      "when": "!recover && grant && (budget > 3'd0)",
      "value": "budget - 3'd1"
    },
    {
      "when": "true",
      "value": "budget"
    }
  ],
  "rtl_variants": [
    {
      "name": "canonical",
      "module_suffix": "canonical_next",
      "file": "canonical_next.sv"
    },
    {
      "name": "sequential",
      "module_suffix": "sequential_priority",
      "file": "sequential_priority.sv"
    },
    {
      "name": "ternary",
      "module_suffix": "ternary_next",
      "file": "ternary_next.sv"
    },
    {
      "name": "function",
      "module_suffix": "function_update",
      "file": "function_update.sv"
    }
  ],
  "notes": [
    "The state register is interface-visible and part of observable equivalence.",
    "All benchmark properties use interface-visible signals only."
  ],
  "properties": [
    {
      "id": "P1_RESET",
      "sva_name": "p_reset_value",
      "type": "next_cycle_implication",
      "natural_language": "reset restores the register to its reset value",
      "antecedent": "rst",
      "consequent": "budget == 3'd7",
      "delay": 1
    },
    {
      "id": "P2_ALLOW",
      "sva_name": "p_allow",
      "type": "invariant",
      "natural_language": "allow is consistent with the observable register value",
      "expression": "allow == (budget != 3'd0)",
      "disable": "rst"
    },
    {
      "id": "P3_RULE",
      "sva_name": "p_rule_3",
      "type": "next_cycle_implication",
      "natural_language": "update rule recover && (budget < 3'd7) produces the specified next value",
      "antecedent": "recover && (budget < 3'd7)",
      "consequent": "budget == ($past(budget) + 3'd1)",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P4_RULE",
      "sva_name": "p_rule_4",
      "type": "next_cycle_implication",
      "natural_language": "update rule !recover && grant && (budget > 3'd0) produces the specified next value",
      "antecedent": "!recover && grant && (budget > 3'd0)",
      "consequent": "budget == ($past(budget) - 3'd1)",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_HOLD",
      "sva_name": "p_hold",
      "type": "next_cycle_implication",
      "natural_language": "when no update rule fires the register holds its value",
      "antecedent": "!(recover && (budget < 3'd7)) && !(!recover && grant && (budget > 3'd0))",
      "consequent": "budget == $past(budget)",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "drop_first_rule",
      "kind": "replace_update_guard",
      "old": "recover && (budget < 3'd7)",
      "new": "false"
    },
    {
      "name": "drop_second_rule",
      "kind": "replace_update_guard",
      "old": "!recover && grant && (budget > 3'd0)",
      "new": "false"
    },
    {
      "name": "broaden_second_rule",
      "kind": "replace_update_guard",
      "old": "!recover && grant && (budget > 3'd0)",
      "new": "true"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "programmatic_template_instantiation",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
