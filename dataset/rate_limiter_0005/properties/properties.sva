// Gold interface properties for rate_limiter_0005

// P1_RESET: reset restores the register to its reset value
property p_reset_value;
    @(posedge clk) (rst) |=> (budget == 3'd7);
endproperty
assert property (p_reset_value);

// P2_ALLOW: allow is consistent with the observable register value
property p_allow;
    @(posedge clk) disable iff (rst) (allow == (budget != 3'd0));
endproperty
assert property (p_allow);

// P3_RULE: update rule recover && (budget < 3'd7) produces the specified next value
property p_rule_3;
    @(posedge clk) disable iff (rst) (recover && (budget < 3'd7)) |=> (budget == ($past(budget) + 3'd1));
endproperty
assert property (p_rule_3);

// P4_RULE: update rule !recover && grant && (budget > 3'd0) produces the specified next value
property p_rule_4;
    @(posedge clk) disable iff (rst) (!recover && grant && (budget > 3'd0)) |=> (budget == ($past(budget) - 3'd1));
endproperty
assert property (p_rule_4);

// P5_HOLD: when no update rule fires the register holds its value
property p_hold;
    @(posedge clk) disable iff (rst) (!(recover && (budget < 3'd7)) && !(!recover && grant && (budget > 3'd0))) |=> (budget == $past(budget));
endproperty
assert property (p_hold);
