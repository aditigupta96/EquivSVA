[
  {
    "id": "P1_RESET",
    "sva_name": "p_reset_value",
    "type": "next_cycle_implication",
    "natural_language": "reset restores the register to its reset value",
    "antecedent": "rst",
    "consequent": "budget == 3'd7",
    "delay": 1
  },
  {
    "id": "P2_ALLOW",
    "sva_name": "p_allow",
    "type": "invariant",
    "natural_language": "allow is consistent with the observable register value",
    "expression": "allow == (budget != 3'd0)",
    "disable": "rst"
  },
  {
    "id": "P3_RULE",
    "sva_name": "p_rule_3",
    "type": "next_cycle_implication",
    "natural_language": "update rule recover && (budget < 3'd7) produces the specified next value",
    "antecedent": "recover && (budget < 3'd7)",
    "consequent": "budget == ($past(budget) + 3'd1)",
    "delay": 1,
    "disable": "rst"
  },
  {
    "id": "P4_RULE",
    "sva_name": "p_rule_4",
    "type": "next_cycle_implication",
    "natural_language": "update rule !recover && grant && (budget > 3'd0) produces the specified next value",
    "antecedent": "!recover && grant && (budget > 3'd0)",
    "consequent": "budget == ($past(budget) - 3'd1)",
    "delay": 1,
    "disable": "rst"
  },
  {
    "id": "P5_HOLD",
    "sva_name": "p_hold",
    "type": "next_cycle_implication",
    "natural_language": "when no update rule fires the register holds its value",
    "antecedent": "!(recover && (budget < 3'd7)) && !(!recover && grant && (budget > 3'd0))",
    "consequent": "budget == $past(budget)",
    "delay": 1,
    "disable": "rst"
  }
]
