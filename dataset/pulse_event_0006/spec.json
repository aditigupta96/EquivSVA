{
  "design_id": "pulse_event_0006",
  "category": "pulse_event",
  "template": "cancelable_pulse",
  "description": "Pulse/event controller implementing cancelable pulse semantics.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true,
    "state": "ARMED"
  },
  "inputs": [
    "trigger",
    "cancel"
  ],
  "outputs": [
    "armed",
    "pulse",
    "cancelled"
  ],
  "states": [
    "ARMED",
    "PULSE",
    "CANCEL"
  ],
  "state_outputs": {
    "ARMED": {
      "armed": 1,
      "pulse": 0,
      "cancelled": 0
    },
    "PULSE": {
      "armed": 0,
      "pulse": 1,
      "cancelled": 0
    },
    "CANCEL": {
      "armed": 0,
      "pulse": 0,
      "cancelled": 1
    }
  },
  "transitions": [
    {
      "from": "ARMED",
      "when": "trigger && !cancel",
      "to": "PULSE"
    },
    {
      "from": "ARMED",
      "when": "cancel",
      "to": "CANCEL"
    },
    {
      "from": "ARMED",
      "when": "!trigger && !cancel",
      "to": "ARMED"
    },
    {
      "from": "PULSE",
      "when": "true",
      "to": "ARMED"
    },
    {
      "from": "CANCEL",
      "when": "true",
      "to": "ARMED"
    }
  ],
  "rtl_variants": [
    "canonical_case",
    "onehot_case",
    "nested_if",
    "factored_flags"
  ],
  "notes": [
    "All benchmark properties use interface-visible signals only.",
    "All RTL variants must be observationally equivalent after reset."
  ],
  "properties": [
    {
      "id": "P1_STATE_ENCODING",
      "sva_name": "p_state_encoding",
      "type": "invariant",
      "natural_language": "observable state outputs always encode at most one active mode",
      "expression": "$onehot0({armed, pulse, cancelled})",
      "disable": "rst"
    },
    {
      "id": "P2_RESET",
      "sva_name": "p_reset_state",
      "type": "next_cycle_implication",
      "natural_language": "reset returns the controller to its reset behavior",
      "antecedent": "rst",
      "consequent": "armed && !pulse && !cancelled",
      "delay": 1
    },
    {
      "id": "P3_T1",
      "sva_name": "p_t1",
      "type": "next_cycle_implication",
      "natural_language": "ARMED transitions to PULSE when trigger && !cancel",
      "antecedent": "(armed && !pulse && !cancelled) && (trigger && !cancel)",
      "consequent": "!armed && pulse && !cancelled",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P4_T2",
      "sva_name": "p_t2",
      "type": "next_cycle_implication",
      "natural_language": "ARMED transitions to CANCEL when cancel",
      "antecedent": "(armed && !pulse && !cancelled) && (cancel)",
      "consequent": "!armed && !pulse && cancelled",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_T3",
      "sva_name": "p_t3",
      "type": "next_cycle_implication",
      "natural_language": "ARMED transitions to ARMED when !trigger && !cancel",
      "antecedent": "(armed && !pulse && !cancelled) && (!trigger && !cancel)",
      "consequent": "armed && !pulse && !cancelled",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P6_T4",
      "sva_name": "p_t4",
      "type": "next_cycle_implication",
      "natural_language": "PULSE transitions to ARMED when true",
      "antecedent": "!armed && pulse && !cancelled",
      "consequent": "armed && !pulse && !cancelled",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P7_T5",
      "sva_name": "p_t5",
      "type": "next_cycle_implication",
      "natural_language": "CANCEL transitions to ARMED when true",
      "antecedent": "!armed && !pulse && cancelled",
      "consequent": "armed && !pulse && !cancelled",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "drop_t1",
      "kind": "replace_transition_guard",
      "from": "ARMED",
      "old": "trigger && !cancel",
      "new": "false"
    },
    {
      "name": "drop_t2",
      "kind": "replace_transition_guard",
      "from": "ARMED",
      "old": "cancel",
      "new": "false"
    },
    {
      "name": "drop_t3",
      "kind": "replace_transition_guard",
      "from": "ARMED",
      "old": "!trigger && !cancel",
      "new": "false"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "programmatic_template_instantiation",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
