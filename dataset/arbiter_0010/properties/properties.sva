// P11_T9: G1 transitions to G1 when done && !req0 && req1.
p_t9: assert property (@(posedge clk) disable iff (rst)
    ((!grant0 && grant1) && (done && !req0 && req1)) |=> (!grant0 && grant1));

// P12_T10: G1 transitions to IDLE when done && !req0 && !req1.
p_t10: assert property (@(posedge clk) disable iff (rst)
