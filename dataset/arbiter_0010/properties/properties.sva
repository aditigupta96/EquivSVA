// P7_T5: G0 transitions to G0 when done && !req1 && req0.
p_t5: assert property (@(posedge clk) disable iff (rst)
    ((grant0 && !grant1) && (done && !req1 && req0)) |=> (grant0 && !grant1));

// P8_T6: G0 transitions to IDLE when done && !req1 && !req0.
p_t6: assert property (@(posedge clk) disable iff (rst)
    ((grant0 && !grant1) && (done && !req1 && !req0)) |=> (!grant0 && !grant1));

// P9_T7: G0 transitions to G0 when !done.
p_t7: assert property (@(posedge clk) disable iff (rst)
