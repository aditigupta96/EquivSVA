[
  {
    "id": "P1_LOW",
    "sva_name": "p_low",
    "type": "invariant",
    "natural_language": "at_low reflects the lower clamp",
    "expression": "at_low == (value == 3'd1)",
    "disable": "rst"
  },
  {
    "id": "P2_HIGH",
    "sva_name": "p_high",
    "type": "invariant",
    "natural_language": "at_high reflects the upper clamp",
    "expression": "at_high == (value == 3'd6)",
    "disable": "rst"
  },
  {
    "id": "P3_DIR_MUTEX",
    "sva_name": "p_dir_mutex",
    "type": "invariant",
    "natural_language": "last_up and last_down are mutually exclusive",
    "expression": "!(last_up && last_down)",
    "disable": "rst"
  },
  {
    "id": "P4_RESET",
    "sva_name": "p_reset",
    "type": "next_cycle_implication",
    "natural_language": "reset restores midpoint and clears direction",
    "antecedent": "rst",
    "consequent": "(value == 3'd3) && !last_up && !last_down",
    "delay": 1
  },
  {
    "id": "P5_INC",
    "sva_name": "p_inc",
    "type": "next_cycle_implication",
    "natural_language": "successful increment advances value and records upward direction",
    "antecedent": "!clear && inc && !dec && (value < 3'd6)",
    "consequent": "(value == ($past(value) + 3'd1)) && last_up",
    "delay": 1,
    "disable": "rst"
  },
  {
    "id": "P6_DEC",
    "sva_name": "p_dec",
    "type": "next_cycle_implication",
    "natural_language": "successful decrement advances value and records downward direction",
    "antecedent": "!clear && dec && !inc && (value > 3'd1)",
    "consequent": "(value == ($past(value) - 3'd1)) && last_down",
    "delay": 1,
    "disable": "rst"
  }
]
