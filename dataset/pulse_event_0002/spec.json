{
  "design_id": "pulse_event_0002",
  "category": "pulse_event",
  "template": "rising_rearm",
  "description": "Pulse/event controller implementing rising rearm semantics.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true,
    "state": "ARMED"
  },
  "inputs": [
    "event_in"
  ],
  "outputs": [
    "armed",
    "pulse",
    "blocked"
  ],
  "states": [
    "ARMED",
    "PULSE",
    "BLOCKED"
  ],
  "state_outputs": {
    "ARMED": {
      "armed": 1,
      "pulse": 0,
      "blocked": 0
    },
    "PULSE": {
      "armed": 0,
      "pulse": 1,
      "blocked": 0
    },
    "BLOCKED": {
      "armed": 0,
      "pulse": 0,
      "blocked": 1
    }
  },
  "transitions": [
    {
      "from": "ARMED",
      "when": "event_in",
      "to": "PULSE"
    },
    {
      "from": "ARMED",
      "when": "!event_in",
      "to": "ARMED"
    },
    {
      "from": "PULSE",
      "when": "true",
      "to": "BLOCKED"
    },
    {
      "from": "BLOCKED",
      "when": "event_in",
      "to": "BLOCKED"
    },
    {
      "from": "BLOCKED",
      "when": "!event_in",
      "to": "ARMED"
    }
  ],
  "rtl_variants": [
    "canonical_case",
    "onehot_case",
    "nested_if",
    "factored_flags"
  ],
  "notes": [
    "All benchmark properties use interface-visible signals only.",
    "All RTL variants must be observationally equivalent after reset."
  ],
  "properties": [
    {
      "id": "P1_STATE_ENCODING",
      "sva_name": "p_state_encoding",
      "type": "invariant",
      "natural_language": "observable state outputs always encode at most one active mode",
      "expression": "$onehot0({armed, pulse, blocked})",
      "disable": "rst"
    },
    {
      "id": "P2_RESET",
      "sva_name": "p_reset_state",
      "type": "next_cycle_implication",
      "natural_language": "reset returns the controller to its reset behavior",
      "antecedent": "rst",
      "consequent": "armed && !pulse && !blocked",
      "delay": 1
    },
    {
      "id": "P3_T1",
      "sva_name": "p_t1",
      "type": "next_cycle_implication",
      "natural_language": "ARMED transitions to PULSE when event_in",
      "antecedent": "(armed && !pulse && !blocked) && (event_in)",
      "consequent": "!armed && pulse && !blocked",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P4_T2",
      "sva_name": "p_t2",
      "type": "next_cycle_implication",
      "natural_language": "ARMED transitions to ARMED when !event_in",
      "antecedent": "(armed && !pulse && !blocked) && (!event_in)",
      "consequent": "armed && !pulse && !blocked",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_T3",
      "sva_name": "p_t3",
      "type": "next_cycle_implication",
      "natural_language": "PULSE transitions to BLOCKED when true",
      "antecedent": "!armed && pulse && !blocked",
      "consequent": "!armed && !pulse && blocked",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P6_T4",
      "sva_name": "p_t4",
      "type": "next_cycle_implication",
      "natural_language": "BLOCKED transitions to BLOCKED when event_in",
      "antecedent": "(!armed && !pulse && blocked) && (event_in)",
      "consequent": "!armed && !pulse && blocked",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P7_T5",
      "sva_name": "p_t5",
      "type": "next_cycle_implication",
      "natural_language": "BLOCKED transitions to ARMED when !event_in",
      "antecedent": "(!armed && !pulse && blocked) && (!event_in)",
      "consequent": "armed && !pulse && !blocked",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "drop_t1",
      "kind": "replace_transition_guard",
      "from": "ARMED",
      "old": "event_in",
      "new": "false"
    },
    {
      "name": "drop_t2",
      "kind": "replace_transition_guard",
      "from": "ARMED",
      "old": "!event_in",
      "new": "false"
    },
    {
      "name": "drop_t4",
      "kind": "replace_transition_guard",
      "from": "BLOCKED",
      "old": "event_in",
      "new": "false"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "programmatic_template_instantiation",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
