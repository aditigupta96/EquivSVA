{
  "design_id": "saturating_arithmetic_0010",
  "category": "saturating_arithmetic",
  "model_type": "register_rules",
  "template": "sat_priority_clear",
  "description": "Saturating arithmetic unit implementing sat priority clear.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true
  },
  "inputs": [
    "clear",
    "inc",
    "dec"
  ],
  "outputs": [
    "value",
    "at_zero",
    "at_max"
  ],
  "signal_widths": {
    "value": 3
  },
  "registers": [
    {
      "name": "value",
      "width": 3,
      "reset_value": "3'd3",
      "observable": true
    }
  ],
  "derived_outputs": {
    "at_zero": "value == 3'd0",
    "at_max": "value == 3'd7"
  },
  "update_rules": [
    {
      "when": "clear",
      "value": "3'd3"
    },
    {
      "when": "!clear && inc && !dec && (value < 3'd7)",
      "value": "value + 3'd1"
    },
    {
      "when": "!clear && dec && !inc && (value > 3'd0)",
      "value": "value - 3'd1"
    },
    {
      "when": "true",
      "value": "value"
    }
  ],
  "rtl_variants": [
    {
      "name": "canonical",
      "module_suffix": "canonical_next",
      "file": "canonical_next.sv"
    },
    {
      "name": "sequential",
      "module_suffix": "sequential_priority",
      "file": "sequential_priority.sv"
    },
    {
      "name": "ternary",
      "module_suffix": "ternary_next",
      "file": "ternary_next.sv"
    },
    {
      "name": "function",
      "module_suffix": "function_update",
      "file": "function_update.sv"
    }
  ],
  "notes": [
    "The state register is interface-visible and part of observable equivalence.",
    "All benchmark properties use interface-visible signals only."
  ],
  "properties": [
    {
      "id": "P1_RESET",
      "sva_name": "p_reset_value",
      "type": "next_cycle_implication",
      "natural_language": "reset restores the register to its reset value",
      "antecedent": "rst",
      "consequent": "value == 3'd3",
      "delay": 1
    },
    {
      "id": "P2_AT_ZERO",
      "sva_name": "p_at_zero",
      "type": "invariant",
      "natural_language": "at_zero is consistent with the observable register value",
      "expression": "at_zero == (value == 3'd0)",
      "disable": "rst"
    },
    {
      "id": "P3_AT_MAX",
      "sva_name": "p_at_max",
      "type": "invariant",
      "natural_language": "at_max is consistent with the observable register value",
      "expression": "at_max == (value == 3'd7)",
      "disable": "rst"
    },
    {
      "id": "P4_RULE",
      "sva_name": "p_rule_4",
      "type": "next_cycle_implication",
      "natural_language": "update rule clear produces the specified next value",
      "antecedent": "clear",
      "consequent": "value == (3'd3)",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_RULE",
      "sva_name": "p_rule_5",
      "type": "next_cycle_implication",
      "natural_language": "update rule !clear && inc && !dec && (value < 3'd7) produces the specified next value",
      "antecedent": "!clear && inc && !dec && (value < 3'd7)",
      "consequent": "value == ($past(value) + 3'd1)",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P6_RULE",
      "sva_name": "p_rule_6",
      "type": "next_cycle_implication",
      "natural_language": "update rule !clear && dec && !inc && (value > 3'd0) produces the specified next value",
      "antecedent": "!clear && dec && !inc && (value > 3'd0)",
      "consequent": "value == ($past(value) - 3'd1)",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P7_HOLD",
      "sva_name": "p_hold",
      "type": "next_cycle_implication",
      "natural_language": "when no update rule fires the register holds its value",
      "antecedent": "!(clear) && !(!clear && inc && !dec && (value < 3'd7)) && !(!clear && dec && !inc && (value > 3'd0))",
      "consequent": "value == $past(value)",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "drop_rule_1",
      "kind": "replace_update_guard",
      "old": "clear",
      "new": "false"
    },
    {
      "name": "drop_rule_2",
      "kind": "replace_update_guard",
      "old": "!clear && inc && !dec && (value < 3'd7)",
      "new": "false"
    },
    {
      "name": "drop_rule_3",
      "kind": "replace_update_guard",
      "old": "!clear && dec && !inc && (value > 3'd0)",
      "new": "false"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "programmatic_template_instantiation",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
