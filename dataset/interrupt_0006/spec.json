{
  "design_id": "interrupt_0006",
  "category": "interrupt_control",
  "template": "masked_latched_irq",
  "description": "Masked interrupt is latched when enabled and cleared by acknowledge.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true,
    "state": "IDLE"
  },
  "inputs": [
    "irq",
    "mask",
    "ack"
  ],
  "outputs": [
    "pending",
    "servicing"
  ],
  "states": [
    "IDLE",
    "PENDING",
    "SERVICE"
  ],
  "state_outputs": {
    "IDLE": {
      "pending": 0,
      "servicing": 0
    },
    "PENDING": {
      "pending": 1,
      "servicing": 0
    },
    "SERVICE": {
      "pending": 0,
      "servicing": 1
    }
  },
  "transitions": [
    {
      "from": "IDLE",
      "when": "irq && !mask",
      "to": "PENDING"
    },
    {
      "from": "IDLE",
      "when": "!(irq && !mask)",
      "to": "IDLE"
    },
    {
      "from": "PENDING",
      "when": "ack",
      "to": "SERVICE"
    },
    {
      "from": "PENDING",
      "when": "!ack",
      "to": "PENDING"
    },
    {
      "from": "SERVICE",
      "when": "true",
      "to": "IDLE"
    }
  ],
  "rtl_variants": [
    "canonical_case",
    "onehot_case",
    "nested_if",
    "factored_flags"
  ],
  "notes": [
    "All benchmark properties use interface-visible signals only.",
    "All RTL variants must be observationally equivalent after reset."
  ],
  "properties": [
    {
      "id": "P1_STATE_ENCODING",
      "sva_name": "p_state_encoding",
      "type": "invariant",
      "natural_language": "observable state outputs always encode at most one active mode",
      "expression": "$onehot0({pending, servicing})",
      "disable": "rst"
    },
    {
      "id": "P2_RESET",
      "sva_name": "p_reset_state",
      "type": "next_cycle_implication",
      "natural_language": "reset returns the controller to its reset behavior",
      "antecedent": "rst",
      "consequent": "!pending && !servicing",
      "delay": 1
    },
    {
      "id": "P3_T1",
      "sva_name": "p_t1",
      "type": "next_cycle_implication",
      "natural_language": "IDLE transitions to PENDING when irq && !mask",
      "antecedent": "(!pending && !servicing) && (irq && !mask)",
      "consequent": "pending && !servicing",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P4_T2",
      "sva_name": "p_t2",
      "type": "next_cycle_implication",
      "natural_language": "IDLE transitions to IDLE when !(irq && !mask)",
      "antecedent": "(!pending && !servicing) && (!(irq && !mask))",
      "consequent": "!pending && !servicing",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_T3",
      "sva_name": "p_t3",
      "type": "next_cycle_implication",
      "natural_language": "PENDING transitions to SERVICE when ack",
      "antecedent": "(pending && !servicing) && (ack)",
      "consequent": "!pending && servicing",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P6_T4",
      "sva_name": "p_t4",
      "type": "next_cycle_implication",
      "natural_language": "PENDING transitions to PENDING when !ack",
      "antecedent": "(pending && !servicing) && (!ack)",
      "consequent": "pending && !servicing",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P7_T5",
      "sva_name": "p_t5",
      "type": "next_cycle_implication",
      "natural_language": "SERVICE transitions to IDLE when true",
      "antecedent": "!pending && servicing",
      "consequent": "!pending && !servicing",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "drop_t1",
      "kind": "replace_transition_guard",
      "from": "IDLE",
      "old": "irq && !mask",
      "new": "false"
    },
    {
      "name": "force_exit_t2",
      "kind": "force_transition",
      "from": "IDLE",
      "to": "PENDING"
    },
    {
      "name": "drop_t3",
      "kind": "replace_transition_guard",
      "from": "PENDING",
      "old": "ack",
      "new": "false"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "programmatic_template_instantiation",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
