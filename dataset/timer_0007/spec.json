{
  "design_id": "timer_0007",
  "category": "timer_watchdog",
  "model_type": "register_rules",
  "template": "countdown_timer",
  "description": "Countdown timer loaded to seven and decremented on tick.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true
  },
  "inputs": [
    "load",
    "tick"
  ],
  "outputs": [
    "remaining",
    "expired"
  ],
  "signal_widths": {
    "remaining": 3
  },
  "registers": [
    {
      "name": "remaining",
      "width": 3,
      "reset_value": "3'd0",
      "observable": true
    }
  ],
  "derived_outputs": {
    "expired": "remaining == 3'd0"
  },
  "update_rules": [
    {
      "when": "load",
      "value": "3'd7"
    },
    {
      "when": "!load && tick && (remaining > 3'd0)",
      "value": "remaining - 3'd1"
    },
    {
      "when": "true",
      "value": "remaining"
    }
  ],
  "rtl_variants": [
    {
      "name": "canonical",
      "module_suffix": "canonical_next",
      "file": "canonical_next.sv"
    },
    {
      "name": "sequential",
      "module_suffix": "sequential_priority",
      "file": "sequential_priority.sv"
    },
    {
      "name": "ternary",
      "module_suffix": "ternary_next",
      "file": "ternary_next.sv"
    },
    {
      "name": "function",
      "module_suffix": "function_update",
      "file": "function_update.sv"
    }
  ],
  "notes": [
    "The state register is interface-visible and part of observable equivalence.",
    "All benchmark properties use interface-visible signals only."
  ],
  "properties": [
    {
      "id": "P1_RESET",
      "sva_name": "p_reset_value",
      "type": "next_cycle_implication",
      "natural_language": "reset restores the register to its reset value",
      "antecedent": "rst",
      "consequent": "remaining == 3'd0",
      "delay": 1
    },
    {
      "id": "P2_EXPIRED",
      "sva_name": "p_expired",
      "type": "invariant",
      "natural_language": "expired is consistent with the observable register value",
      "expression": "expired == (remaining == 3'd0)",
      "disable": "rst"
    },
    {
      "id": "P3_RULE",
      "sva_name": "p_rule_3",
      "type": "next_cycle_implication",
      "natural_language": "update rule load produces the specified next value",
      "antecedent": "load",
      "consequent": "remaining == (3'd7)",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P4_RULE",
      "sva_name": "p_rule_4",
      "type": "next_cycle_implication",
      "natural_language": "update rule !load && tick && (remaining > 3'd0) produces the specified next value",
      "antecedent": "!load && tick && (remaining > 3'd0)",
      "consequent": "remaining == ($past(remaining) - 3'd1)",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_HOLD",
      "sva_name": "p_hold",
      "type": "next_cycle_implication",
      "natural_language": "when no update rule fires the register holds its value",
      "antecedent": "!(load) && !(!load && tick && (remaining > 3'd0))",
      "consequent": "remaining == $past(remaining)",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "ignore_load",
      "kind": "replace_update_guard",
      "old": "load",
      "new": "false"
    },
    {
      "name": "ignore_tick",
      "kind": "replace_update_guard",
      "old": "!load && tick && (remaining > 3'd0)",
      "new": "false"
    },
    {
      "name": "count_without_tick",
      "kind": "replace_update_guard",
      "old": "!load && tick && (remaining > 3'd0)",
      "new": "!load && (remaining > 3'd0)"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "programmatic_template_instantiation",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
