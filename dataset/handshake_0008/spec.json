{
  "design_id": "handshake_0008",
  "category": "handshake",
  "template": "retry_handshake",
  "description": "Request can be accepted, retried, or completed.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true,
    "state": "IDLE"
  },
  "inputs": [
    "req",
    "accept",
    "retry"
  ],
  "outputs": [
    "busy",
    "retrying",
    "done"
  ],
  "states": [
    "IDLE",
    "WAIT",
    "RETRY",
    "DONE"
  ],
  "state_outputs": {
    "IDLE": {
      "busy": 0,
      "retrying": 0,
      "done": 0
    },
    "WAIT": {
      "busy": 1,
      "retrying": 0,
      "done": 0
    },
    "RETRY": {
      "busy": 0,
      "retrying": 1,
      "done": 0
    },
    "DONE": {
      "busy": 0,
      "retrying": 0,
      "done": 1
    }
  },
  "transitions": [
    {
      "from": "IDLE",
      "when": "req",
      "to": "WAIT"
    },
    {
      "from": "IDLE",
      "when": "!req",
      "to": "IDLE"
    },
    {
      "from": "WAIT",
      "when": "retry",
      "to": "RETRY"
    },
    {
      "from": "WAIT",
      "when": "!retry && accept",
      "to": "DONE"
    },
    {
      "from": "WAIT",
      "when": "!retry && !accept",
      "to": "WAIT"
    },
    {
      "from": "RETRY",
      "when": "true",
      "to": "WAIT"
    },
    {
      "from": "DONE",
      "when": "true",
      "to": "IDLE"
    }
  ],
  "rtl_variants": [
    "canonical_case",
    "onehot_case",
    "nested_if",
    "factored_flags"
  ],
  "notes": [
    "All benchmark properties use interface-visible signals only.",
    "All RTL variants must be observationally equivalent after reset."
  ],
  "properties": [
    {
      "id": "P1_STATE_ENCODING",
      "sva_name": "p_state_encoding",
      "type": "invariant",
      "natural_language": "observable state outputs always encode at most one active mode",
      "expression": "$onehot0({busy, retrying, done})",
      "disable": "rst"
    },
    {
      "id": "P2_RESET",
      "sva_name": "p_reset_state",
      "type": "next_cycle_implication",
      "natural_language": "reset returns the controller to its reset behavior",
      "antecedent": "rst",
      "consequent": "!busy && !retrying && !done",
      "delay": 1
    },
    {
      "id": "P3_T1",
      "sva_name": "p_t1",
      "type": "next_cycle_implication",
      "natural_language": "IDLE transitions to WAIT when req",
      "antecedent": "(!busy && !retrying && !done) && (req)",
      "consequent": "busy && !retrying && !done",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P4_T2",
      "sva_name": "p_t2",
      "type": "next_cycle_implication",
      "natural_language": "IDLE transitions to IDLE when !req",
      "antecedent": "(!busy && !retrying && !done) && (!req)",
      "consequent": "!busy && !retrying && !done",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_T3",
      "sva_name": "p_t3",
      "type": "next_cycle_implication",
      "natural_language": "WAIT transitions to RETRY when retry",
      "antecedent": "(busy && !retrying && !done) && (retry)",
      "consequent": "!busy && retrying && !done",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P6_T4",
      "sva_name": "p_t4",
      "type": "next_cycle_implication",
      "natural_language": "WAIT transitions to DONE when !retry && accept",
      "antecedent": "(busy && !retrying && !done) && (!retry && accept)",
      "consequent": "!busy && !retrying && done",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P7_T5",
      "sva_name": "p_t5",
      "type": "next_cycle_implication",
      "natural_language": "WAIT transitions to WAIT when !retry && !accept",
      "antecedent": "(busy && !retrying && !done) && (!retry && !accept)",
      "consequent": "busy && !retrying && !done",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P8_T6",
      "sva_name": "p_t6",
      "type": "next_cycle_implication",
      "natural_language": "RETRY transitions to WAIT when true",
      "antecedent": "!busy && retrying && !done",
      "consequent": "busy && !retrying && !done",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P9_T7",
      "sva_name": "p_t7",
      "type": "next_cycle_implication",
      "natural_language": "DONE transitions to IDLE when true",
      "antecedent": "!busy && !retrying && done",
      "consequent": "!busy && !retrying && !done",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "drop_t1",
      "kind": "replace_transition_guard",
      "from": "IDLE",
      "old": "req",
      "new": "false"
    },
    {
      "name": "force_exit_t2",
      "kind": "force_transition",
      "from": "IDLE",
      "to": "WAIT"
    },
    {
      "name": "drop_t3",
      "kind": "replace_transition_guard",
      "from": "WAIT",
      "old": "retry",
      "new": "false"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "programmatic_template_instantiation",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
