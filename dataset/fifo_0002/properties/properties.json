[
  {
    "id": "P1_READY",
    "sva_name": "p_ready",
    "type": "invariant",
    "natural_language": "ready is asserted exactly when the buffer is empty",
    "disable": "rst",
    "expression": "ready == !valid"
  },
  {
    "id": "P2_RESET",
    "sva_name": "p_reset",
    "type": "next_cycle_implication",
    "natural_language": "reset empties the buffer",
    "antecedent": "rst",
    "consequent": "!valid",
    "delay": 1
  },
  {
    "id": "P3_PUSH",
    "sva_name": "p_push",
    "type": "next_cycle_implication",
    "natural_language": "a push while empty stores the item",
    "disable": "rst",
    "antecedent": "!valid && push",
    "consequent": "valid && (dout == $past(din))",
    "delay": 1
  },
  {
    "id": "P4_FULL_HOLD",
    "sva_name": "p_full_hold",
    "type": "next_cycle_implication",
    "natural_language": "a push while full without pop is rejected",
    "disable": "rst",
    "antecedent": "valid && push && !pop",
    "consequent": "valid && (dout == $past(dout))",
    "delay": 1
  },
  {
    "id": "P5_POP",
    "sva_name": "p_pop",
    "type": "next_cycle_implication",
    "natural_language": "a pop from a full buffer empties it",
    "disable": "rst",
    "antecedent": "valid && pop",
    "consequent": "!valid",
    "delay": 1
  },
  {
    "id": "P6_EMPTY_IDLE",
    "sva_name": "p_empty_idle",
    "type": "next_cycle_implication",
    "natural_language": "an empty buffer remains empty without push",
    "disable": "rst",
    "antecedent": "!valid && !push",
    "consequent": "!valid",
    "delay": 1
  }
]
