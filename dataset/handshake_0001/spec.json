{
  "design_id": "handshake_0001",
  "category": "handshake",
  "description": "Three-state request/acknowledge controller with cancellation.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true,
    "state": "IDLE"
  },
  "inputs": [
    "req",
    "ready",
    "cancel"
  ],
  "outputs": [
    "busy",
    "ack"
  ],
  "states": [
    "IDLE",
    "WAIT",
    "ACK"
  ],
  "state_outputs": {
    "IDLE": {
      "busy": 0,
      "ack": 0
    },
    "WAIT": {
      "busy": 1,
      "ack": 0
    },
    "ACK": {
      "busy": 0,
      "ack": 1
    }
  },
  "transitions": [
    {
      "from": "IDLE",
      "when": "req && ready",
      "to": "WAIT"
    },
    {
      "from": "IDLE",
      "when": "!(req && ready)",
      "to": "IDLE"
    },
    {
      "from": "WAIT",
      "when": "cancel",
      "to": "IDLE"
    },
    {
      "from": "WAIT",
      "when": "!cancel",
      "to": "ACK"
    },
    {
      "from": "ACK",
      "when": "true",
      "to": "IDLE"
    }
  ],
  "rtl_variants": [
    "canonical_case",
    "onehot_case",
    "nested_if",
    "factored_flags"
  ],
  "notes": [
    "All benchmark properties use interface-visible signals only.",
    "All variants must be equivalent after the required initial reset cycle."
  ],
  "properties": [
    {
      "id": "P1_MUTEX",
      "sva_name": "p_mutex",
      "type": "invariant",
      "natural_language": "busy and ack are never asserted together",
      "disable": "rst",
      "expression": "!(busy && ack)"
    },
    {
      "id": "P2_RESET_IDLE",
      "sva_name": "p_reset_idle",
      "type": "next_cycle_implication",
      "natural_language": "a reset cycle leaves the controller idle on the following cycle",
      "antecedent": "rst",
      "consequent": "!busy && !ack",
      "delay": 1
    },
    {
      "id": "P3_ACCEPT_TO_BUSY",
      "sva_name": "p_accept_to_busy",
      "type": "next_cycle_implication",
      "natural_language": "an accepted request starts a transaction",
      "disable": "rst",
      "antecedent": "(!busy && !ack) && req && ready",
      "consequent": "busy",
      "delay": 1
    },
    {
      "id": "P4_IDLE_STAYS_IDLE",
      "sva_name": "p_idle_stays_idle",
      "type": "next_cycle_implication",
      "natural_language": "without an accepted request, an idle controller stays idle",
      "disable": "rst",
      "antecedent": "(!busy && !ack) && !(req && ready)",
      "consequent": "!busy && !ack",
      "delay": 1
    },
    {
      "id": "P5_CANCEL_TO_IDLE",
      "sva_name": "p_cancel_to_idle",
      "type": "next_cycle_implication",
      "natural_language": "cancellation while busy aborts the transaction",
      "disable": "rst",
      "antecedent": "busy && cancel",
      "consequent": "!busy && !ack",
      "delay": 1
    },
    {
      "id": "P6_BUSY_TO_ACK",
      "sva_name": "p_busy_to_ack",
      "type": "next_cycle_implication",
      "natural_language": "a non-cancelled busy transaction produces ack next cycle",
      "disable": "rst",
      "antecedent": "busy && !cancel",
      "consequent": "ack",
      "delay": 1
    },
    {
      "id": "P7_ACK_TO_IDLE",
      "sva_name": "p_ack_to_idle",
      "type": "next_cycle_implication",
      "natural_language": "ack is a one-cycle state and returns to idle",
      "disable": "rst",
      "antecedent": "ack",
      "consequent": "!busy && !ack",
      "delay": 1
    }
  ],
  "mutants": [
    {
      "name": "ignore_ready",
      "kind": "replace_transition_guard",
      "from": "IDLE",
      "old": "req && ready",
      "new": "req"
    },
    {
      "name": "cancel_to_ack",
      "kind": "force_transition",
      "from": "WAIT",
      "to": "ACK"
    },
    {
      "name": "ack_stuck",
      "kind": "force_transition",
      "from": "ACK",
      "to": "ACK"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "manually_authored",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
