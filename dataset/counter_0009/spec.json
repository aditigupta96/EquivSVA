{
  "design_id": "counter_0009",
  "category": "counter",
  "model_type": "register_rules",
  "template": "bounded_up_down_counter",
  "description": "Three-bit up/down counter bounded at zero and seven.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true
  },
  "inputs": [
    "up",
    "down"
  ],
  "outputs": [
    "count",
    "at_zero",
    "at_max"
  ],
  "signal_widths": {
    "count": 3
  },
  "registers": [
    {
      "name": "count",
      "width": 3,
      "reset_value": "3'd0",
      "observable": true
    }
  ],
  "derived_outputs": {
    "at_zero": "count == 3'd0",
    "at_max": "count == 3'd7"
  },
  "update_rules": [
    {
      "when": "up && !down && (count < 3'd7)",
      "value": "count + 3'd1"
    },
    {
      "when": "down && !up && (count > 3'd0)",
      "value": "count - 3'd1"
    },
    {
      "when": "true",
      "value": "count"
    }
  ],
  "rtl_variants": [
    {
      "name": "canonical",
      "module_suffix": "canonical_next",
      "file": "canonical_next.sv"
    },
    {
      "name": "sequential",
      "module_suffix": "sequential_priority",
      "file": "sequential_priority.sv"
    },
    {
      "name": "ternary",
      "module_suffix": "ternary_next",
      "file": "ternary_next.sv"
    },
    {
      "name": "function",
      "module_suffix": "function_update",
      "file": "function_update.sv"
    }
  ],
  "notes": [
    "The state register is interface-visible and part of observable equivalence.",
    "All benchmark properties use interface-visible signals only."
  ],
  "properties": [
    {
      "id": "P1_RESET",
      "sva_name": "p_reset_value",
      "type": "next_cycle_implication",
      "natural_language": "reset restores the register to its reset value",
      "antecedent": "rst",
      "consequent": "count == 3'd0",
      "delay": 1
    },
    {
      "id": "P2_AT_ZERO",
      "sva_name": "p_at_zero",
      "type": "invariant",
      "natural_language": "at_zero is consistent with the observable register value",
      "expression": "at_zero == (count == 3'd0)",
      "disable": "rst"
    },
    {
      "id": "P3_AT_MAX",
      "sva_name": "p_at_max",
      "type": "invariant",
      "natural_language": "at_max is consistent with the observable register value",
      "expression": "at_max == (count == 3'd7)",
      "disable": "rst"
    },
    {
      "id": "P4_RULE",
      "sva_name": "p_rule_4",
      "type": "next_cycle_implication",
      "natural_language": "update rule up && !down && (count < 3'd7) produces the specified next value",
      "antecedent": "up && !down && (count < 3'd7)",
      "consequent": "count == ($past(count) + 3'd1)",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_RULE",
      "sva_name": "p_rule_5",
      "type": "next_cycle_implication",
      "natural_language": "update rule down && !up && (count > 3'd0) produces the specified next value",
      "antecedent": "down && !up && (count > 3'd0)",
      "consequent": "count == ($past(count) - 3'd1)",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P6_HOLD",
      "sva_name": "p_hold",
      "type": "next_cycle_implication",
      "natural_language": "when no update rule fires the register holds its value",
      "antecedent": "!(up && !down && (count < 3'd7)) && !(down && !up && (count > 3'd0))",
      "consequent": "count == $past(count)",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "ignore_up",
      "kind": "replace_update_guard",
      "old": "up && !down && (count < 3'd7)",
      "new": "false"
    },
    {
      "name": "ignore_down",
      "kind": "replace_update_guard",
      "old": "down && !up && (count > 3'd0)",
      "new": "false"
    },
    {
      "name": "up_when_both",
      "kind": "replace_update_guard",
      "old": "up && !down && (count < 3'd7)",
      "new": "up && (count < 3'd7)"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "programmatic_template_instantiation",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
