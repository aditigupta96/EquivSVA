// Generated from spec.json.
// Design: arbiter_0003

// P1_MUTUAL_EXCLUSION: the arbiter never grants both requesters simultaneously.
p_mutual_exclusion: assert property (@(posedge clk) disable iff (rst)
    !(grant0 && grant1));

// P2_RESET_NO_GRANT: reset clears both grants.
p_reset_no_grant: assert property (@(posedge clk)
    (rst) |=> (!grant0 && !grant1));

// P3_REQ0_GRANTED: request 0 receives ownership when the arbiter is idle.
p_req0_granted: assert property (@(posedge clk) disable iff (rst)
    (!grant0 && !grant1 && req0) |=> (grant0 && !grant1));

// P4_REQ1_GRANTED: request 1 receives ownership while idle when request 0 is absent.
p_req1_granted: assert property (@(posedge clk) disable iff (rst)
    (!grant0 && !grant1 && !req0 && req1) |=> (!grant0 && grant1));

// P5_IDLE_PRIORITY: request 0 wins when both requests arrive while idle.
p_idle_priority: assert property (@(posedge clk) disable iff (rst)
    (!grant0 && !grant1 && req0 && req1) |=> (grant0 && !grant1));

// P6_GRANT0_HOLDS: grant 0 remains asserted while request 0 remains active.
p_grant0_holds: assert property (@(posedge clk) disable iff (rst)
    (grant0 && req0) |=> (grant0 && !grant1));

// P7_GRANT0_HANDOFF: when requester 0 releases and requester 1 is waiting, ownership transfers directly to requester 1.
p_grant0_handoff: assert property (@(posedge clk) disable iff (rst)
    (grant0 && !req0 && req1) |=> (!grant0 && grant1));

// P8_GRANT0_RELEASE: when requester 0 releases with no competing request, the arbiter returns to idle.
p_grant0_release: assert property (@(posedge clk) disable iff (rst)
    (grant0 && !req0 && !req1) |=> (!grant0 && !grant1));

// P9_GRANT1_HOLDS: grant 1 remains asserted while request 1 remains active.
p_grant1_holds: assert property (@(posedge clk) disable iff (rst)
    (grant1 && req1) |=> (!grant0 && grant1));

// P10_GRANT1_HANDOFF: when requester 1 releases and requester 0 is waiting, ownership transfers directly to requester 0.
p_grant1_handoff: assert property (@(posedge clk) disable iff (rst)
    (grant1 && !req1 && req0) |=> (grant0 && !grant1));

// P11_GRANT1_RELEASE: when requester 1 releases with no competing request, the arbiter returns to idle.
p_grant1_release: assert property (@(posedge clk) disable iff (rst)
    (grant1 && !req1 && !req0) |=> (!grant0 && !grant1));

// P12_IDLE_HOLDS: without any request an idle arbiter remains idle.
p_idle_holds: assert property (@(posedge clk) disable iff (rst)
    (!grant0 && !grant1 && !req0 && !req1) |=> (!grant0 && !grant1));
