[
  {
    "id": "P1_TICK_REQUIRES_ACTIVE",
    "type": "invariant",
    "natural_language": "tick is only asserted while the periodic timer is active",
    "disable": "rst",
    "expression": "!tick || active"
  },
  {
    "id": "P2_RESET_IDLE",
    "type": "next_cycle_implication",
    "natural_language": "reset returns the periodic timer to idle",
    "antecedent": "rst",
    "consequent": "!active && !tick",
    "delay": 1
  },
  {
    "id": "P3_START",
    "type": "next_cycle_implication",
    "natural_language": "start activates the periodic timer",
    "disable": "rst",
    "antecedent": "!active && !tick && start",
    "consequent": "active && !tick",
    "delay": 1
  },
  {
    "id": "P4_IDLE_HOLDS",
    "type": "next_cycle_implication",
    "natural_language": "without start the timer remains idle",
    "disable": "rst",
    "antecedent": "!active && !tick && !start",
    "consequent": "!active && !tick",
    "delay": 1
  },
  {
    "id": "P5_RUN_TO_TICK",
    "type": "next_cycle_implication",
    "natural_language": "the running timer produces a tick on the following cycle",
    "disable": "rst",
    "antecedent": "active && !tick",
    "consequent": "active && tick",
    "delay": 1
  },
  {
    "id": "P6_TICK_REARMS",
    "type": "next_cycle_implication",
    "natural_language": "after a tick the periodic timer automatically rearms",
    "disable": "rst",
    "antecedent": "active && tick",
    "consequent": "active && !tick",
    "delay": 1
  }
]
