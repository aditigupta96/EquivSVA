{
  "design_id": "handshake_0007",
  "category": "handshake",
  "template": "valid_ready_completion",
  "description": "Producer raises valid, waits for ready, then emits a completion state.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true,
    "state": "IDLE"
  },
  "inputs": [
    "produce",
    "ready"
  ],
  "outputs": [
    "valid",
    "done"
  ],
  "states": [
    "IDLE",
    "VALID",
    "DONE"
  ],
  "state_outputs": {
    "IDLE": {
      "valid": 0,
      "done": 0
    },
    "VALID": {
      "valid": 1,
      "done": 0
    },
    "DONE": {
      "valid": 0,
      "done": 1
    }
  },
  "transitions": [
    {
      "from": "IDLE",
      "when": "produce",
      "to": "VALID"
    },
    {
      "from": "IDLE",
      "when": "!produce",
      "to": "IDLE"
    },
    {
      "from": "VALID",
      "when": "ready",
      "to": "DONE"
    },
    {
      "from": "VALID",
      "when": "!ready",
      "to": "VALID"
    },
    {
      "from": "DONE",
      "when": "true",
      "to": "IDLE"
    }
  ],
  "rtl_variants": [
    "canonical_case",
    "onehot_case",
    "nested_if",
    "factored_flags"
  ],
  "notes": [
    "All benchmark properties use interface-visible signals only.",
    "All RTL variants must be observationally equivalent after reset."
  ],
  "properties": [
    {
      "id": "P1_STATE_ENCODING",
      "sva_name": "p_state_encoding",
      "type": "invariant",
      "natural_language": "observable state outputs always encode at most one active mode",
      "expression": "$onehot0({valid, done})",
      "disable": "rst"
    },
    {
      "id": "P2_RESET",
      "sva_name": "p_reset_state",
      "type": "next_cycle_implication",
      "natural_language": "reset returns the controller to its reset behavior",
      "antecedent": "rst",
      "consequent": "!valid && !done",
      "delay": 1
    },
    {
      "id": "P3_T1",
      "sva_name": "p_t1",
      "type": "next_cycle_implication",
      "natural_language": "IDLE transitions to VALID when produce",
      "antecedent": "(!valid && !done) && (produce)",
      "consequent": "valid && !done",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P4_T2",
      "sva_name": "p_t2",
      "type": "next_cycle_implication",
      "natural_language": "IDLE transitions to IDLE when !produce",
      "antecedent": "(!valid && !done) && (!produce)",
      "consequent": "!valid && !done",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_T3",
      "sva_name": "p_t3",
      "type": "next_cycle_implication",
      "natural_language": "VALID transitions to DONE when ready",
      "antecedent": "(valid && !done) && (ready)",
      "consequent": "!valid && done",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P6_T4",
      "sva_name": "p_t4",
      "type": "next_cycle_implication",
      "natural_language": "VALID transitions to VALID when !ready",
      "antecedent": "(valid && !done) && (!ready)",
      "consequent": "valid && !done",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P7_T5",
      "sva_name": "p_t5",
      "type": "next_cycle_implication",
      "natural_language": "DONE transitions to IDLE when true",
      "antecedent": "!valid && done",
      "consequent": "!valid && !done",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "drop_t1",
      "kind": "replace_transition_guard",
      "from": "IDLE",
      "old": "produce",
      "new": "false"
    },
    {
      "name": "force_exit_t2",
      "kind": "force_transition",
      "from": "IDLE",
      "to": "VALID"
    },
    {
      "name": "drop_t3",
      "kind": "replace_transition_guard",
      "from": "VALID",
      "old": "ready",
      "new": "false"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "programmatic_template_instantiation",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
