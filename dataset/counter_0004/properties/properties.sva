// Gold interface properties for counter_0004

// P1_MAX_FLAG: at_max matches count equal to three
property p_max_flag;
    @(posedge clk) disable iff (rst) (at_max == (count == 2'd3));
endproperty
assert property (p_max_flag);

// P2_CLEAR_PRIORITY: clear has priority over load and enable
property p_clear_priority;
    @(posedge clk) disable iff (rst) (clear) |=> (count == 2'd0);
endproperty
assert property (p_clear_priority);

// P3_LOAD: a load cycle installs the supplied load value
property p_load;
    @(posedge clk) disable iff (rst) (!clear && load) |=> (count == $past(load_value));
endproperty
assert property (p_load);

// P4_INCREMENT: without clear or load an enabled counter increments below maximum
property p_increment;
    @(posedge clk) disable iff (rst) (!clear && !load && enable && (count < 2'd3)) |=> (count == ($past(count) + 2'd1));
endproperty
assert property (p_increment);

// P5_HOLD: without clear load or enable the count is retained
property p_hold;
    @(posedge clk) disable iff (rst) (!clear && !load && !enable) |=> (count == $past(count));
endproperty
assert property (p_hold);

// P6_SATURATE: incrementing at maximum remains saturated
property p_saturate;
    @(posedge clk) disable iff (rst) (!clear && !load && enable && (count == 2'd3)) |=> ((count == 2'd3) && at_max);
endproperty
assert property (p_saturate);
