{
  "design_id": "pulse_event_0005",
  "category": "pulse_event",
  "template": "two_sample_debounced_pulse",
  "description": "Pulse generator requires two consecutive high samples before firing and two low samples before rearming.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true,
    "state": "ARMED"
  },
  "inputs": [
    "event_in"
  ],
  "outputs": [
    "armed",
    "qualifying",
    "pulse",
    "rearming"
  ],
  "states": [
    "ARMED",
    "HIGH1",
    "PULSE",
    "WAIT_LOW",
    "LOW1"
  ],
  "state_outputs": {
    "ARMED": {
      "armed": 1,
      "qualifying": 0,
      "pulse": 0,
      "rearming": 0
    },
    "HIGH1": {
      "armed": 0,
      "qualifying": 1,
      "pulse": 0,
      "rearming": 0
    },
    "PULSE": {
      "armed": 0,
      "qualifying": 0,
      "pulse": 1,
      "rearming": 0
    },
    "WAIT_LOW": {
      "armed": 0,
      "qualifying": 0,
      "pulse": 0,
      "rearming": 1
    },
    "LOW1": {
      "armed": 0,
      "qualifying": 0,
      "pulse": 0,
      "rearming": 1
    }
  },
  "transitions": [
    {
      "from": "ARMED",
      "when": "event_in",
      "to": "HIGH1"
    },
    {
      "from": "ARMED",
      "when": "!event_in",
      "to": "ARMED"
    },
    {
      "from": "HIGH1",
      "when": "event_in",
      "to": "PULSE"
    },
    {
      "from": "HIGH1",
      "when": "!event_in",
      "to": "ARMED"
    },
    {
      "from": "PULSE",
      "when": "true",
      "to": "WAIT_LOW"
    },
    {
      "from": "WAIT_LOW",
      "when": "!event_in",
      "to": "LOW1"
    },
    {
      "from": "WAIT_LOW",
      "when": "event_in",
      "to": "WAIT_LOW"
    },
    {
      "from": "LOW1",
      "when": "!event_in",
      "to": "ARMED"
    },
    {
      "from": "LOW1",
      "when": "event_in",
      "to": "WAIT_LOW"
    }
  ],
  "rtl_variants": [
    "canonical_case",
    "onehot_case",
    "nested_if",
    "factored_flags"
  ],
  "notes": [
    "All benchmark properties use interface-visible signals only.",
    "All RTL variants must be observationally equivalent after reset."
  ],
  "properties": [
    {
      "id": "P1_ONEHOT",
      "sva_name": "p_onehot",
      "type": "invariant",
      "natural_language": "debounce phases are mutually exclusive",
      "expression": "$onehot0({armed, qualifying, pulse})",
      "disable": "rst"
    },
    {
      "id": "P2_RESET",
      "sva_name": "p_reset",
      "type": "next_cycle_implication",
      "natural_language": "reset arms the detector",
      "antecedent": "rst",
      "consequent": "armed",
      "delay": 1
    },
    {
      "id": "P3_FIRST_HIGH",
      "sva_name": "p_first_high",
      "type": "next_cycle_implication",
      "natural_language": "the first high sample begins qualification",
      "antecedent": "armed && event_in",
      "consequent": "qualifying",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P4_SECOND_HIGH",
      "sva_name": "p_second_high",
      "type": "next_cycle_implication",
      "natural_language": "a second consecutive high sample emits a pulse",
      "antecedent": "qualifying && event_in",
      "consequent": "pulse",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_GLITCH",
      "sva_name": "p_glitch",
      "type": "next_cycle_implication",
      "natural_language": "a one-cycle high glitch does not emit a pulse",
      "antecedent": "qualifying && !event_in",
      "consequent": "armed",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P6_FIRST_LOW",
      "sva_name": "p_first_low",
      "type": "next_cycle_implication",
      "natural_language": "the first low after a pulse begins rearming",
      "antecedent": "rearming && !event_in",
      "consequent": "rearming || armed",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P7_HIGH_INTERRUPTS_REARM",
      "sva_name": "p_high_interrupt",
      "type": "next_cycle_implication",
      "natural_language": "a high sample interrupts low rearming",
      "antecedent": "rearming && event_in",
      "consequent": "rearming",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "fire_after_one_high",
      "kind": "force_transition",
      "from": "ARMED",
      "to": "PULSE"
    },
    {
      "name": "never_fire",
      "kind": "replace_transition_guard",
      "from": "HIGH1",
      "old": "event_in",
      "new": "false"
    },
    {
      "name": "rearm_after_one_low",
      "kind": "force_transition",
      "from": "WAIT_LOW",
      "to": "ARMED"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "manually_authored",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
