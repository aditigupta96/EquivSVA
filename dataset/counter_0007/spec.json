{
  "design_id": "counter_0007",
  "category": "counter",
  "model_type": "register_rules",
  "template": "saturating_down_counter",
  "description": "Saturating down-counter starting from seven.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true
  },
  "inputs": [
    "reload",
    "enable"
  ],
  "outputs": [
    "count",
    "at_zero"
  ],
  "signal_widths": {
    "count": 3
  },
  "registers": [
    {
      "name": "count",
      "width": 3,
      "reset_value": "3'd7",
      "observable": true
    }
  ],
  "derived_outputs": {
    "at_zero": "count == 3'd0"
  },
  "update_rules": [
    {
      "when": "reload",
      "value": "3'd7"
    },
    {
      "when": "!reload && enable && (count > 3'd0)",
      "value": "count - 3'd1"
    },
    {
      "when": "true",
      "value": "count"
    }
  ],
  "rtl_variants": [
    {
      "name": "canonical",
      "module_suffix": "canonical_next",
      "file": "canonical_next.sv"
    },
    {
      "name": "sequential",
      "module_suffix": "sequential_priority",
      "file": "sequential_priority.sv"
    },
    {
      "name": "ternary",
      "module_suffix": "ternary_next",
      "file": "ternary_next.sv"
    },
    {
      "name": "function",
      "module_suffix": "function_update",
      "file": "function_update.sv"
    }
  ],
  "notes": [
    "The state register is interface-visible and part of observable equivalence.",
    "All benchmark properties use interface-visible signals only."
  ],
  "properties": [
    {
      "id": "P1_RESET",
      "sva_name": "p_reset_value",
      "type": "next_cycle_implication",
      "natural_language": "reset restores the register to its reset value",
      "antecedent": "rst",
      "consequent": "count == 3'd7",
      "delay": 1
    },
    {
      "id": "P2_AT_ZERO",
      "sva_name": "p_at_zero",
      "type": "invariant",
      "natural_language": "at_zero is consistent with the observable register value",
      "expression": "at_zero == (count == 3'd0)",
      "disable": "rst"
    },
    {
      "id": "P3_RULE",
      "sva_name": "p_rule_3",
      "type": "next_cycle_implication",
      "natural_language": "update rule reload produces the specified next value",
      "antecedent": "reload",
      "consequent": "count == (3'd7)",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P4_RULE",
      "sva_name": "p_rule_4",
      "type": "next_cycle_implication",
      "natural_language": "update rule !reload && enable && (count > 3'd0) produces the specified next value",
      "antecedent": "!reload && enable && (count > 3'd0)",
      "consequent": "count == ($past(count) - 3'd1)",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_HOLD",
      "sva_name": "p_hold",
      "type": "next_cycle_implication",
      "natural_language": "when no update rule fires the register holds its value",
      "antecedent": "!(reload) && !(!reload && enable && (count > 3'd0))",
      "consequent": "count == $past(count)",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "ignore_reload",
      "kind": "replace_update_guard",
      "old": "reload",
      "new": "false"
    },
    {
      "name": "ignore_enable",
      "kind": "replace_update_guard",
      "old": "!reload && enable && (count > 3'd0)",
      "new": "!reload && (count > 3'd0)"
    },
    {
      "name": "never_decrement",
      "kind": "replace_update_guard",
      "old": "!reload && enable && (count > 3'd0)",
      "new": "false"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "programmatic_template_instantiation",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
