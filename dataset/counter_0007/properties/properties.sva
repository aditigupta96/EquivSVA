// Gold interface properties for counter_0007

// P1_RESET: reset restores the register to its reset value
property p_reset_value;
    @(posedge clk) (rst) |=> (count == 3'd7);
endproperty
assert property (p_reset_value);

// P2_AT_ZERO: at_zero is consistent with the observable register value
property p_at_zero;
    @(posedge clk) disable iff (rst) (at_zero == (count == 3'd0));
endproperty
assert property (p_at_zero);

// P3_RULE: update rule reload produces the specified next value
property p_rule_3;
    @(posedge clk) disable iff (rst) (reload) |=> (count == (3'd7));
endproperty
assert property (p_rule_3);

// P4_RULE: update rule !reload && enable && (count > 3'd0) produces the specified next value
property p_rule_4;
    @(posedge clk) disable iff (rst) (!reload && enable && (count > 3'd0)) |=> (count == ($past(count) - 3'd1));
endproperty
assert property (p_rule_4);

// P5_HOLD: when no update rule fires the register holds its value
property p_hold;
    @(posedge clk) disable iff (rst) (!(reload) && !(!reload && enable && (count > 3'd0))) |=> (count == $past(count));
endproperty
assert property (p_hold);
