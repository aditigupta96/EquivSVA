[
  {
    "id": "P1_STATE_ENCODING",
    "type": "invariant",
    "natural_language": "observable state outputs always encode at most one active mode",
    "expression": "$onehot0({low_pending, high_pending, service})",
    "disable": "rst"
  },
  {
    "id": "P2_RESET",
    "type": "next_cycle_implication",
    "natural_language": "reset returns the controller to its reset behavior",
    "antecedent": "rst",
    "consequent": "!low_pending && !high_pending && !service",
    "delay": 1
  },
  {
    "id": "P3_T1",
    "type": "next_cycle_implication",
    "natural_language": "IDLE transitions to HIGH when irq_hi",
    "antecedent": "(!low_pending && !high_pending && !service) && (irq_hi)",
    "consequent": "!low_pending && high_pending && !service",
    "delay": 1,
    "disable": "rst"
  },
  {
    "id": "P4_T2",
    "type": "next_cycle_implication",
    "natural_language": "IDLE transitions to LOW when !irq_hi && irq_lo",
