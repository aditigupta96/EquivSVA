    "delay": 1
  },
  {
    "id": "P8_AFTER_GRANT1_REQ0_PRIORITY",
    "type": "next_cycle_implication",
    "natural_language": "after granting requester 1, a waiting requester 0 receives the next grant",
    "disable": "rst",
    "antecedent": "grant1 && req0",
