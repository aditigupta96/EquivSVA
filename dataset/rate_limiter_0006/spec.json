{
  "design_id": "rate_limiter_0006",
  "category": "rate_limiter",
  "model_type": "register_rules",
  "template": "quota_counter",
  "description": "Rate-control state implementing quota counter.",
  "clock": {
    "name": "clk",
    "edge": "posedge"
  },
  "reset": {
    "name": "rst",
    "active": "high",
    "synchronous": true
  },
  "inputs": [
    "use",
    "reset_quota"
  ],
  "outputs": [
    "quota",
    "allow"
  ],
  "signal_widths": {
    "quota": 3
  },
  "registers": [
    {
      "name": "quota",
      "width": 3,
      "reset_value": "3'd5",
      "observable": true
    }
  ],
  "derived_outputs": {
    "allow": "quota != 3'd0"
  },
  "update_rules": [
    {
      "when": "reset_quota",
      "value": "3'd5"
    },
    {
      "when": "!reset_quota && use && (quota > 3'd0)",
      "value": "quota - 3'd1"
    },
    {
      "when": "true",
      "value": "quota"
    }
  ],
  "rtl_variants": [
    {
      "name": "canonical",
      "module_suffix": "canonical_next",
      "file": "canonical_next.sv"
    },
    {
      "name": "sequential",
      "module_suffix": "sequential_priority",
      "file": "sequential_priority.sv"
    },
    {
      "name": "ternary",
      "module_suffix": "ternary_next",
      "file": "ternary_next.sv"
    },
    {
      "name": "function",
      "module_suffix": "function_update",
      "file": "function_update.sv"
    }
  ],
  "notes": [
    "The state register is interface-visible and part of observable equivalence.",
    "All benchmark properties use interface-visible signals only."
  ],
  "properties": [
    {
      "id": "P1_RESET",
      "sva_name": "p_reset_value",
      "type": "next_cycle_implication",
      "natural_language": "reset restores the register to its reset value",
      "antecedent": "rst",
      "consequent": "quota == 3'd5",
      "delay": 1
    },
    {
      "id": "P2_ALLOW",
      "sva_name": "p_allow",
      "type": "invariant",
      "natural_language": "allow is consistent with the observable register value",
      "expression": "allow == (quota != 3'd0)",
      "disable": "rst"
    },
    {
      "id": "P3_RULE",
      "sva_name": "p_rule_3",
      "type": "next_cycle_implication",
      "natural_language": "update rule reset_quota produces the specified next value",
      "antecedent": "reset_quota",
      "consequent": "quota == (3'd5)",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P4_RULE",
      "sva_name": "p_rule_4",
      "type": "next_cycle_implication",
      "natural_language": "update rule !reset_quota && use && (quota > 3'd0) produces the specified next value",
      "antecedent": "!reset_quota && use && (quota > 3'd0)",
      "consequent": "quota == ($past(quota) - 3'd1)",
      "delay": 1,
      "disable": "rst"
    },
    {
      "id": "P5_HOLD",
      "sva_name": "p_hold",
      "type": "next_cycle_implication",
      "natural_language": "when no update rule fires the register holds its value",
      "antecedent": "!(reset_quota) && !(!reset_quota && use && (quota > 3'd0))",
      "consequent": "quota == $past(quota)",
      "delay": 1,
      "disable": "rst"
    }
  ],
  "mutants": [
    {
      "name": "drop_first_rule",
      "kind": "replace_update_guard",
      "old": "reset_quota",
      "new": "false"
    },
    {
      "name": "drop_second_rule",
      "kind": "replace_update_guard",
      "old": "!reset_quota && use && (quota > 3'd0)",
      "new": "false"
    },
    {
      "name": "broaden_second_rule",
      "kind": "replace_update_guard",
      "old": "!reset_quota && use && (quota > 3'd0)",
      "new": "true"
    }
  ],
  "provenance": {
    "source_type": "original_synthetic",
    "source": "EquivSVA",
    "behavior_spec_creation": "programmatic_template_instantiation",
    "rtl_generation": "programmatic_from_behavior_spec",
    "derived_from_external_benchmark": false
  }
}
